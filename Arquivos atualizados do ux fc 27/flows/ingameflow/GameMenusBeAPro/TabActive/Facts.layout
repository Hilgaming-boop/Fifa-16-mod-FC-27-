{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		    "script" : [ { "anim" : "QUICK_ANIMATION_IN" } ]
	    },
	    {
			"name" : "hide",
		    "script" : [ { "anim" : "QUICK_ANIMATION_OUT" } ]
	    }
    ],
    "children":
    [
        {                
            "commonName": "Rectangle",
            "alignV": "CENTER",
            "alignH": "RIGHT",
            "marginRight": 120,
            "marginTop": 10,
            "width": 550,
            "height": 380,
            "color": "0x151515",
            "cornerRaduis": 15,
            "alpha": 0.9
        },
        {
            "commonName": "Image",
            "name": "LogoTeamHome",
            "alignH": "CENTER",
            "alignV": "CENTER",
            "marginTop": -125,
            "marginLeft": 133,
            "scaleX": 0.27,
            "scaleY": 0.27,
            "bindings":
            [
               {
                   "binding": "bnd_home_team_crest",
                   "property": "image"
               }
            ]
       },
       {
            "commonName": "Image",
            "name": "LogoTeamAway",
            "alignH": "CENTER",
            "alignV": "CENTER",
            "marginTop": -125,
            "marginLeft": 535,
            "scaleX": 0.27,
            "scaleY": 0.27,
            "bindings":
            [
               {
                   "binding": "bnd_away_team_crest",
                   "property": "image"
               }
            ]
        },
        {
            "commonName": "Label",
            "name": "NameTeamHome",
            "alignH": "CENTER",
            "alignV": "CENTER",
            "marginTop": -75,
            "marginLeft": 132,
            "fontSize": 17,
            "fontColor": "$COLOR_WHITE",
            "fontFace": "$CruyffSansRegular",
            "forceCaps": false,
            "bindings":
            [
               {
                   "binding": "bnd_home_team_name_abbr",
                   "property": "text"
               }
            ]              
        },
        {
            "commonName": "Label",
            "name": "NameTeamAway",
            "alignH": "CENTER",
            "alignV": "CENTER",
            "marginTop": -75,
            "marginLeft": 535,
            "fontSize": 17,
            "fontColor": "$COLOR_WHITE",
            "fontFace": "$CruyffSansRegular",
            "forceCaps": false,
            "bindings":
            [
               {
                   "binding": "bnd_away_team_name_abbr",
                   "property": "text"
               }
            ]                
        },
        {
            "commonName": "Label",
            "alignH": "CENTER",
            "alignV": "CENTER",
            "marginTop": -87,
            "marginLeft": 330,
            "fontSize": 14,
            "fontColor": "$COLOR_LIGHT_GRAY",
            "fontFace": "$CruyffSansRegular",
            "text": "Statistics"
        },
        {                    
            "commonName": "Asset",
            "name": "Pitch",
            "alignH": "CENTER",
            "alignV": "CENTER",
            "marginTop": -30,
            "marginLeft": 333,
            "height": 70,
            "width": 450,
            "enabled": false,
            "isInteractive": false,
