{
  "commonName": "Panel",
  "name": "rootContainer",
  "alignH": "CENTER",
  "alignV": "CENTER",
  "bindings": [
    {
      "binding": "BND_SCREEN_WIDTH",
      "property": "width"
    },
    {
      "binding": "BND_SCREEN_HEIGHT",
      "property": "height"
    }
  ],
  "animationScripts": [
    {
      "name": "show",
      "script": [
        {
          "anim": "SCREEN_SHOW"
        }
      ]
    },
    {
      "name": "hide",
      "script": [
        {
          "anim": "SIMPLE_SCREEN_HIDE"
        }
      ]
    }
  ],
  "style-definitions":
    {
		"TF_LIVE_TILE_HEADLINE_BOLD_SMALL":
        {
			"fontFace": "$CruyffSans-Expandes",
			"fontSize": 16,
			"fontColor": "$COLOR_LIGHT_GRAY",
            "alpha": 0.5,
			"leading": 0
	    },
		"TF_LIVE_TILE_HEADLINE_SMALL": 
        {
			"fontFace": "$CruyffSans-Expandes",
			"fontSize": 16,
			"fontColor": "$COLOR_WHITE",
			"leading": -4
		},
		"TF_LIVE_TILE_HEADLINE_BOLD_HIGHLIGHTED_SMALL": 
        {
			"fontFace": "$CruyffSans-Expandes",
			"fontSize": 16,
			"fontColor": "$COLOR_WHITE",
			"leading": -4
		},
		"TF_LIVE_TILE_HEADLINE_HIGHLIGHTED_SMALL":
        {
			"fontFace": "$CruyffSans-Expandes",
			"fontSize": 16,
		    "fontColor": "$COLOR_WHITE",
			"leading": -4
        }
    },
