/*-- Modified MVNPROD Youtube Channel --*/

{
    "commonName": "Panel",
    "name": "rootContainer",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
		         	"name" : "show",
		         	"script" :
		         	[
			             	{
					              "anim" : "SCREEN_SHOW"
			             	}
		         	]
		     },
		     {
		         	"name" : "hide",
		         	"script" :
		         	[
			             	{
					              "anim" : "SIMPLE_SCREEN_HIDE"
			             	}
		         	]
	       	}
    ],
    "children":
    [
        {
            "commonName": "Panel",
            "name": "MatchReveal",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 1,
            "bindings":
            [
                {
                    "property": "visible",
                    "binding":  "bnd_universal_show"
                }
            ],
            "children":
            [                              
                {
                    "commonName": "Image",
                    "name": "insHomeStadium",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "bindings":
                    [
                        {
                            "property": "image",
                            "binding":  "bnd_home_stadium_bg"
                        }
                    ]
                },
                {
                    "commonName": "Image",
                    "alignV": "BOTTOM",
                    "alignH": "CENTER",
                    "marginBottom": 520,
                    "marginLeft": 595,
                    "width": 150,
                    "height": 100,
                    "bindings":
                    [
                        {
                            "property": "image",
                            "binding":  "bnd_live_logo"
                        }
                    ]
                },
                {
                    "commonName": "Asset",
                    "name": "Bg",
                    "alignV": "BOTTOM",
                    "alignH": "CENTER",
                    "marginBottom": 10,
                    "marginLeft": -303,
                    "width": 790,  
                    "height": 260,         
