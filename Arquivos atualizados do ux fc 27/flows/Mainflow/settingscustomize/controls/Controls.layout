{
    "commonName": "Panel",
    "name": "rootContainer",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
  "animationScripts": [
    {
      "name": "show",
      "script": [
        {
          "anim": "GROUND_TO_TOP_IN"
        }
      ]
    },
    {
      "name": "hide",
      "script": [
        {
          "anim": "GROUND_TO_TOP_OUT"
        }
      ]
    }
  ],
    "children":
    [
        {
            "commonName": "Panel",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginLeft": -13,
            "height": 580,
            "children":
            [
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 107,
                    "marginLeft": 90,
                    "fontSize": 25,
                    "fontColor": "$COLOR_WHITE",
                    "fontFace": "$FONT_ORIGIN_KNULEXTRABOLD",
                    "text": "Customise Control"
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 150,
                    "marginLeft": 90,
                    "fontSize": 17,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "fontFace": "$FONT_TIMER",
                    "text": "You can make control settings now"
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 174,
                    "marginLeft": 90,
                    "fontSize": 17,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "fontFace": "$FONT_TIMER",
                    "text": "Virtual button, controller, button poisition and player skill"
                }
            ]
        },
        {
            "commonName": "Panel",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
                {
                    "commonName": "Asset",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 34,
                    "marginLeft": 500,
                    "height": 70,
                    "width": 180,
                    "alpha": 1,
                    "path": "views/backgrounds/Green_Effect.swf"
                },
                {
                    "commonName": "BigBinaryToggle",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginTop": -80,
                    "marginLeft": 53,
                    "styles": ["TF_LABEL_CENTERED"],
                    "visible":    true,
                    "onLabel":          "LTXT_MOB_SETTINGS_CONTROLLER",
                    "onSelectedIcon":   "$CONTROL_ICON_GAMEPAD_GREY",
                    "onUnselectedIcon": "$CONTROL_ICON_TOUCHPAD_WHITE",
                    "onAction":         "act_select_touch_controls",
                    "offLabel":         "LTXT_MOB_SETTINGS_VIRTUAL",
                    "offUnselectedIcon":"$CONTROL_ICON_GAMEPAD_WHITE",
                    "offSelectedIcon":  "$CONTROL_ICON_TOUCHPAD_GREY",
                    "offAction":        "act_select_controller_controls",
                    "bindings":
                    [
                        {
                            "property": "isOn",
                            "binding":  "bnd_is_touch_control"
                        }
                    ]
                 }
             ]
         }
     ]
}