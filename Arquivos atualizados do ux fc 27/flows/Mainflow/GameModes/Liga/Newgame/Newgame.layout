{
  "commonName": "Panel",
  "name": "rootContainer",
  "alignV": "CENTER",
  "alignH": "CENTER",
  "bindings": [
    {
      "binding": "BND_SCREEN_WIDTH",
      "property": "width"
    },
    {
      "binding": "BND_SCREEN_HEIGHT",
      "property": "height"
    }
  ],
  "animationScripts": [
    {
      "name": "show",
      "script": [
        {
          "anim": "SCREEN_SHOW"
        }
      ]
    },
    {
      "name": "hide",
      "script": [
        {
          "anim": "SIMPLE_SCREEN_HIDE"
        }
      ]
    }
  ],
  "behaviors": [
    {
      "commonName": "SquadCustomizationBehavior",
      "actionName": "act_selected",
      "buttonContainer": "FifaButton"
    }
  ],
  "children": [
