                    "marginLeft": -492,
                    "fontFace": "$CruyffSans-Bold",
                    "fontSize": 20,
                    "fontColor": "$COLOR_FIFA_MOD_WHITE",
                    "alpha": 1,
                    "text": "Set Scout"
                    },
                 {
                 "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "CENTER",
                    "marginTop": -3,
                    "marginLeft": -430,
                    "fontFace": "$DINPro",
                    "fontSize": 17,
                    "fontColor": "$COLOR_FIFA_MOD_WHITE",
                    "alpha": 0.7,
                    "text": "|"
