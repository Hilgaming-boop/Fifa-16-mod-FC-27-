/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "name": "rootContainer",
    "alignV": "CENTER",
    "alignH": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        },
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Liga"
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": 0,
            "marginLeft": 320,
            "width": 0,
            "height": 0,
            "children":
            [
                {
                    "commonName": "Rectangle",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "cornerRaduis": 20,
                    "color": "0x1E1E1E",
                    "alpha": 1
                },
                {
                    "commonName": "Image",
                    "name": "Scout",
                    "alignH": "CENTER",
                    "alignV": "CENTER",
                    "marginTop": -60.0,
                    "scaleX": 0.29,
                    "scaleY": 0.29,
                    "scaleZ": 0.29,
                    "bindings":
                    [
                        {
                            "binding": "bnd_scout",
                            "property": "image"
                        }
                    ]
                }
            ]
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": -50,
            "marginLeft": -5400,
            "width": 270,
            "height": 60,
            "children":
            [
                {
                    "commonName": "Rectangle",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "cornerRaduis": 20,
                    "color": "0x1C1C1C",
                    "alpha": 0.6
                }
            ]
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
                {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": -10,
                    "marginLeft": 120,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": -10,
                    "marginLeft": 176,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
		                {
                        "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -180,
                            "marginLeft": 100,
                            "width": 400,
                            "height": 150,
                            "type": "$Set_Scout_Info"
                            },		                		                
		                {
                        "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "CENTER",
                    "marginTop": 0,
                    "marginLeft": -580,
                    "fontFace": "$CruyffSans-Regular",
