		            "marginTop": 290,
                    "marginLeft": 80,
                    "scaleX": 2.5,
                    "scaleY": 2.5,
		            "width": 90,
		            "height": 25,
		            "children":
		            [
						{
                        "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "width": 30,
                            "height": 30,
                            "type": "$BlueArrowRight"
                            },
			                {
		                    "commonName": "GenericButton",
		                    "alignV": "CENTER",
		                    "clickAction": "act_next"                    
		                }
		            ]
		        },
				{
		            "commonName": "Panel",
		            "name": "togglebtn1",
		            "alignV": "CENTER",
		            "alignH": "CENTER",
		            "marginTop": 290,
                    "marginLeft": -50,
                    "scaleX": 2.5,
                    "scaleY": 2.5,
		            "width": 90,
		            "height": 25,
