                    "alpha": 0.6,
                    "text": "---"
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "CENTER",
                    "marginTop": 526,
                    "marginLeft": -15,
                    "fontSize": 0,
                    "fontFace": "$CruyffSans-Bold",
                    "bold": false,
                    "bindings":
                    [
                        {
                            "binding": "bnd_matchday_label",
                            "property": "text"
                        },
                        {
                            "binding":  "bnd_fontColor",
                            "property": "fontColor"                           
                         }
                    ]
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "CENTER",
                    "marginTop": 233,
                    "marginLeft": -1000,
                    "fontSize": 20,
                    "fontFace": "$CruyffSans-Bold",
                    "fontColor": "$COLOR_WHITE",
                    "bold": false,
                    "bindings":
                    [
                        {
                            "binding": "bnd_team_label",
                            "property": "text"
                        }
                    ]
                },
                {
                    "commonName": "VerticalList",
                    "name": "matchlist",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 150,
                    "marginLeft": -130,
                    "x": 0,
                    "y": 0,
                    "displayRange": 7,
                    "highlightable": true,
                    "row": "Setscout",
                    "rowHeight": 60,
                    "rowWidth": 455,
                    "bindings":
                    [
                        {
                            "binding": "bnd_match_list",
                            "property": "dataProviders"
                        }
                    ]
                },
                {
		            "commonName": "Panel",
		            "name": "scoutbtn",
		            "alignV": "CENTER",
		            "alignH": "CENTER",
		            "marginTop": 330,
		            "marginLeft": 170,
		            "width": 90,
		            "height": 25,
		            "children":
		            [
		                {
		                    "commonName": "Label",
		                    "alignV": "CENTER",
		                    "alignH": "CENTER",
							"marginLeft": 35,
		                    "fontSize": 14,
		                    "fontColor": "$COLOR_WHITE",
		                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                            "alpha": 0.7,
		                    "text": "Set Up"
		                },
						{
                        "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "width": 30,
                            "height": 30,
                            "type": "$SimMatchIcon1"
                            },
		                {
		                    "commonName": "GenericButton",
		                    "alignV": "CENTER",
