            "marginLeft": 180,
            "fontSize": 25,
            "fontColor": "$COLOR_WHITE",
            "fontFace": "$MONTBLANC_TRIAL_BOLD",
            "bindings":
            [
                {
                    "binding": "bnd_league_label",
                    "property": "text"
                }
            ]
        },
