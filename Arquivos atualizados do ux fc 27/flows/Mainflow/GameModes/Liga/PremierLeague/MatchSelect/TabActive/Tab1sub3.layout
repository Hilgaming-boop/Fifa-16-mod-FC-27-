      "marginLeft": 370,
      "marginTop": 20,
      "width": 370,
      "height": 430,
      "children": [
        {
           "commonName": "Rectangle",
           "alignV": "FILL",
           "alignH": "FILL",
           "cornerRaduis": 8,
           "alpha": 1,
           "bindings": [
             {
                 "binding": "bnd_league_color",
                 "property": "color"
              }
            ]
         },
        {
          "commonName": "Label",
          "alignV": "TOP",
