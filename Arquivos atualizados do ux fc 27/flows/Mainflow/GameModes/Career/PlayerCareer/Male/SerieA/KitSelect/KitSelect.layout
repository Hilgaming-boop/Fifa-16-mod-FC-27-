{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings": [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts": [
        {
            "name": "show",
            "script": [
                {
                    "anim": "ANIMASI_MASUK_MAINMENU"
                }
            ]
        },
        {
            "name": "",
            "script": [
                {
                    "anim": "ANIMASI_KELUAR_MAINMENU"
                }
            ]
        }
    ],
    "behaviors": [
        {
            "commonName": "SquadCustomizationBehavior",
            "actionName": "act_btn_click",
            "buttonContainer": "insButtonsOptionsBot"
        }
    ],
    "style-definitions":
	{
		"TF_TEAM_NAME":
		{
            "text-format": "fow.style.SquadStyle.TF_FORMATION_NAME",
            "fontColor": "$COLOR_WHITE",
            "textAlignH": "CENTER"
		},
		"TF_TEAM_NAME1":
		{
            "fontFace": "$Italic",
            "fontColor": "$COLOR_WHITE",
            "fontSize": 80,
            "textAlignH": "CENTER",
            "bold": false
		},
		"TF_SUBS_REMAINING_LABEL":
        {
            "fontTitle": "$FONT_TITLE",
            "fontSize": 22,
            "fontColor": "$COLOR_WHITE",
            "textAlignH": "CENTER"
        },
		"TF_TEAM_STATS_LABEL":
		{
            "text-format": "fow.style.SquadStyle.TF_COMBOBOX_LABEL",
            "fontColor": "$COLOR_WHITE"
        },
		"TF_COMPARISON_TITLE": 
       {
			"fontFace": "$FONT_BOLD",
			"fontSize": "$FONT_SIZE_LARGEST",
			"fontColor": "$COLOR_ORANGE",
			"alpha": 0,
			"leading": -4,
			"textAlignH": "CENTER"
	   },
		"TF_COMPARISON_LABELS": 
       {
			"fontFace": "$CruyffSansRegular",
			"fontSize": 15,
			"fontColor": "$COLOR_LIGHT_GRAY",
			"textAlignH": "CENTER",
			"height": 58,
			"width": 230,
			"leading": -15,
			"underline": false,
			"multiline": true
		},
		"TF_COMPARISON_STATS_RED":
        {
			"fontFace": "$CruyffSansMedium",
			"fontSize": 15,
			"fontColor": "$COLOR_WHITE",
			"textAlignH": "CENTER",
			"leading": 29
		},
		"TF_COMPARISON_STATS_BLUE_NEUTRAL": 
        {
			"fontFace": "$CruyffSansMedium",
			"fontSize": 15,
			"fontColor": "$COLOR_WHITE",
			"textAlignH": "CENTER",
			"leading": 29
		},
		"TF_COMPARISON_STATS_BLUE_POSITIVE": 
        {
			"fontFace": "$CruyffSansMedium",
			"fontSize": 15,
			"fontColor": "$COLOR_GREEN",
			"textAlignH": "CENTER",
			"leading": 29
		},
		"TF_COMPARISON_STATS_BLUE_NEGATIVE":
        {
			"fontFace": "$CruyffSansMedium",
			"fontSize": 15,
			"fontColor": "$COLOR_LIGHT_RED",
			"textAlignH": "CENTER",
			"leading": 29
	    },
		"PLAYER_BRONZE_SHORTNAME": 
        {
			"fontFace": "$CruyffSansMedium",
			"fontSize": 13,
			"fontColor": "$COLOR_WHITE",
			"x": 21,
			"y": 90,
			"textAlignH": "CENTER"
	    },
		"PLAYER_BRONZE_SMALLRATING": 
        {
			"fontFace": "$CruyffSansMedium",
			"fontSize": 15,
			"x": 80,
			"y": 63,
			"fontColor": "$COLOR_WHITE",
			"textAlignH": "LEFT"
		},
		"PLAYER_BRONZE_POSITION": 
        {
			"fontFace": "$CruyffSansRegular",
			"fontSize": 12,
			"x": 5,
			"y": 41,
			"alpha": 0,
			"fontColor": "$COLOR_WHITE"
        },
		"PLAYER_SILVER_SHORTNAME": 
