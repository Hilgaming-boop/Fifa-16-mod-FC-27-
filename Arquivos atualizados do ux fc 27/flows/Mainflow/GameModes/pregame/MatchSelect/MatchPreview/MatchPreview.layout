            {
              "type": "Direct",
              "data": { "end": { "alpha": 0, "marginRight": -50 }, "duration": 200 }
            },
            { "type": "Delay", "data": { "duration": 100 } },
            {
              "type": "Direct",
              "data": {
                "end": { "alpha": 1, "scaleX": 1, "scaleY": 1, "marginRight": 0 },
                "duration": 500,
                "easing": "OutBack"
              }
            }
          ]
        }
      ],
      "children": [
