                            "marginTop": -6,
                            "marginLeft": 80,
                            "scaleX": 1.1,
                            "scaleY": 1.1,
                            "name": "insStarRating",
                            "bindings":
                            [
                                {
                                    "binding": "bnd_team_rating",
                                    "property": "stars"
                                }
                            ]
                        },
                        {
                            "commonName": "Label",
                            "name": "rating",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginLeft": 50,
                            "marginTop": 33,
                            "width": 150,
                            "textAlignH": "CENTER",
                            "fontFace": "$FONT_BOLD",
                            "fontColor": "$COLOR_YELLOW",
                            "fontSize": 17,
                            "forceCaps": false,
                            "autoTextShadow": true,
                            "autoScroll":true,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_team_rating_label",
                                    "property": "text"
                                }
                            ]
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "BOTTOM",
                            "alignH": "LEFT",
                            "marginLeft": 60,
                            "marginBottom": 20,
                            "fontSize": 17,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_BOLD",
                            "alpha": 0.7,
                            "text": "Formation"
                        },
                        {
                            "commonName": "DragToggle",
                            "itemStyleName": "SquadToggleInfo",
                            "itemType": "Label",
                            "toggleAction":
                            {
                                "action": "act_change",
                                "binding": "bnd_formation_index"
                            },
                            "x": 0,
                            "y": 10,
                            "width": 200,
                            "height": 30,
                            "alignV": "BOTTOM",
                            "alignH": "LEFT",
                            "marginBottom": -15,
                            "marginLeft": -10,
                            "name": "insFormationToggle",
                            "arrowType": "blue_small",
                            "bindings":
                            [
                                {
                                    "binding": "bnd_formation_list",
                                    "property": "dataProviders"
                                }
                            ]
                        }
                    ]
