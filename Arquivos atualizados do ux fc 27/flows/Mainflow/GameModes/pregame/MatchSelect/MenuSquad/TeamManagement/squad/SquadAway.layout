			"alignH": "CENTER",
			"marginBottom": 120.0,
			"name": "insSquad",
			"children":
            [
                {
                    "commonName": "SquadChemistryLinks",
                    "alignH": "CENTER",
                    "alignV": "CENTER",
                    "marginTop": 0,
                    "marginLeft": 100000000,
                    "name": "insChemistryLinks",
                    "bindings":
                    [
                        {
                            "binding": "bnd_chemistry_matrix",
                            "property": "formationChemistry"
                        }
                    ]
                },
                {
                    "commonName": "SquadLayout",
                    "contextMenuEnabled": true,
                    "exchangeTargetNames":
                    [
                        "insSquad.insItemDock"
                    ],
                    "itemView": 1,
                    "highlightable": true,
                    "alignH": "CENTER",
                    "alignV": "CENTER",
                    "marginTop": 0,
                    "marginRight": 0,
                    "scaleX": 0.75,
                    "scaleY": 0.75,
                    "name": "insSquadLayout",
                    "bindings":
                    [
                        {
                            "binding": "bnd_context_menu",
                            "property": "contextMenuEnabled"
                        },
                        {
                            "binding": "bnd_item_view",
                            "property": "itemView"
                        },
                        {
                            "binding": "bnd_formation",
                            "property": "formation"
                        },
                        {
                            "binding": "bnd_enable_item_interaction",
                            "property": "resetItemInteraction"
                        },
                        {
                            "binding": "bnd_starting_11",
                            "property": "starting11"
                        }
                    ]
                },
                {
                    "commonName": "SubsDrawer",
                    "selectable": true,
                    "mouseInteractive": true,
                    "contextMenuEnabled": true,
                    "exchangeTargetNames":
                    [
                        "insSquad.insSquadLayout"
                    ],
                    "itemView": 1,
                    "size": 0,
                    "autoHide": false,
                    "scrollable": true,
                    "draggable": true,
                    "highlightable": true,
                    "autoHide": true,
                    "alignV": "BOTTOM",
                    "alignH": "CENTER",
                    "marginBottom": -80,
                    "width": 1500,
                    "name": "insItemDock",
                    "displayType": "SUBS_AND_RES",                    
                    "bindings":
                    [
                        {
                            "binding": "bnd_subs_and_res",
                            "property": "dataProviders"
                        }
                    ]
                }
            ]
        }
