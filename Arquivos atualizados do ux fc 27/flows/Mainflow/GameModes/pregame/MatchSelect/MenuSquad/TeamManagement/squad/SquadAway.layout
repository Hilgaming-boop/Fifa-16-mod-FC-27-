        {
            "commonName": "Panel",
            "alignV": "FILL",
            "alignH": "FILL",
            "name": "insTeamStats",
            "children":
            [
                {
                    "commonName": "Panel",
                    "name": "InfoManager",
                    "alignV": "TOP",
                    "alignH": "RIGHT",
                    "marginRight": 18,
                    "marginTop": 20,
                    "width": 260,
                    "height": 270,
                    "children":
                    [
                        {
                            "commonName": "Image",
                            "name": "man",
                            "alignV": "FILL",
                            "alignH": "FILL",
                            "bindings":
                            [
                                {
                                    "binding": "bnd_team_man",
                                    "property": "image"
                                }
                            ]
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "InfoTeam",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginLeft": 80,
                    "marginTop": 60,
                    "width": 300,
                    "height": 190,
                    "children":
                    [
                        {
                            "commonName": "Image",
                            "name": "LogoTim",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginLeft": 0,
                            "marginTop": 10,
                            "width": 70,  
                            "height": 70,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_team_crest",
                                    "property": "image"
                                }
                            ]
                        },
                        {
                            "commonName": "Label",
                            "name": "NamaTim",
                            "alignV": "CENTER",
