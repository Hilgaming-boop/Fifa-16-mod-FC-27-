/*-- Modified MVNPROD Youtube Channel --*/

{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "behaviors":
    [
        {
            "commonName": "SquadTeamManagementBehavior",
            "starting11": "insSquad.insSquadLayout",
            "subsAndReserves": "insSquad.insItemDock",
            "actionName": "act_swap_players"
        },
        {
            "commonName": "SquadPlayerComparisonBehavior",
            "comparisonTargetNames":
            [
                "insSquad.insSquadLayout",
                "insSquad.insItemDock"
            ],
            "actionName": "act_compare_players"
        },
        {
            "commonName": "TickerNavPublisher",
            "alignH": "LEFT",
            "marginLeft": 140,
            "actionName": "act_advance",
