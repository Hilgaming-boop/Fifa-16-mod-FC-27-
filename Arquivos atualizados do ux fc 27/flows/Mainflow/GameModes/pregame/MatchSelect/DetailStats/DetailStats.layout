  "behaviors": [
    {
      "commonName": "TriggerScriptBehavior",
      "name": "trigger_fadein_homekit",
      "script": "animateCount0",
      "target": "panelHomeKit"
    },
    {
      "commonName": "TriggerOnTrue",
      "name": "trigger_on_true_homekit",
      "target": "trigger_fadein_homekit",
      "bindings": [
        { "binding": "bnd_animate_count0", "property": "value" }
      ]
    },
    {
      "commonName": "TriggerScriptBehavior",
      "name": "trigger_fadein_homenamelogo",
      "script": "animateCount1",
      "target": "panelHomeNameLogo"
    },
    {
      "commonName": "TriggerOnTrue",
      "name": "trigger_on_true_homenamelogo",
