{
    "commonName": "Panel",
    "name": "rootContainer",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings": [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts": [
        {
            "name": "show",
            "script": [
                {
                    "anim": "ANIMASI_MASUK_MAINMENU"
                }
            ]
        },
        {
            "name": "",
            "script": [
                {
                    "anim": "ANIMASI_KELUAR_MAINMENU"
                }
            ]
        }
    ],
    "style-definitions": {
        "TF_RIGHT_PANEL": {
            "fontFace": "$MONTBLANC_TRIAL_BOLD",
            "fontSize": "$FONT_SIZE_MEDIUM",
            "fontColor": "$COLOR_WHITE",
            "textAlignH": "CENTER",
            "leading": -2
        },
        "TF_SETTINGS_ROW_LABEL": {
            "fontFace": "$MONTBLANC_TRIAL_BOLD",
            "fontSize": "$FONT_SIZE_SMALLEST_HEADER",
            "fontColor": "$COLOR_WHITE",
            "textAlignH": "LEFT"
        },
        "TF_SETTINGS_ROW_LABEL_DISABLED": {
            "fontFace": "$MONTBLANC_TRIAL_BOLD",
            "fontSize": "$FONT_SIZE_MEDIUM_HEADER",
            "fontColor": "$COLOR_WHITE",
            "textAlignH": "LEFT"
        },
        "TF_SETTINGS_ROW_TOGGLE": {
            "fontFace": "$MONTBLANC_TRIAL_BOLD",
            "fontSize": "$FONT_SIZE_SMALLEST_HEADER",
            "fontColor": "$COLOR_WHITE",
            "textAlignH": "CENTER"
        },
        "TF_GENERAL_TEXT": {
            "fontFace": "$MONTBLANC_TRIAL_BOLD",
            "fontSize": "$FONT_SIZE_MEDIUM",
            "fontColor": "$COLOR_WHITE"
        },
        "TF_MULTILINE_TEXT": {
            "fontFace": "$MONTBLANC_TRIAL_BOLD",
            "fontSize": "$FONT_SIZE_LARGEST",
            "fontColor": "$COLOR_WHITE",
            "leading": 0.1
        },
        "TF_CUSTOMIZE_INGAME_WARNING": {
            "fontFace": "$MONTBLANC_TRIAL_BOLD",
            "fontSize": 14,
            "fontColor": "$COLOR_BLUE"
        }
    },
