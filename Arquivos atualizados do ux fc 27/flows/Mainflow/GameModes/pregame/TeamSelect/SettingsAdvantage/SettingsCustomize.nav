{
    "name": "SettingsAdvantage",
    "states":
    [
        {
            "name": "HideSettingsCustomize",
            "transitions":
            [
                {
                    "event":   "evt_to_settings_advantage",
                    "targets": ["ShowSettingsCustomize"]
                }
            ]
        },
        {
            "name": "ShowSettingsCustomize",
			"type": "parallel",
            "states":
            [
				{
					"name": "SettingsCustomizeTabs",
					"onEnter":
					[
						["set", ["context", ".event.data"]],
						["blockingLoadVVM", ["/Flows/MainFlow/Gamemodes/PreGame/teamselect/SettingsAdvantage/SettingsCustomize.vvm", ".context"]]
					],
					"onExit":
					[
						["unloadVVM"]
					],
					"initial":
					{
						"targets": ["MatchSettings"]
					},
					"states":
					[

						{
							"name": "MatchSettings",
							"onEnter":
							[
								["viewLayer", ["SettingsCustomizeContent"]],
								["setSettingsCustomizeTabContext", [0]],
								["loadVVM", ["/Flows/MainFlow/Gamemodes/PreGame/teamselect/SettingsAdvantage/customization/Customization.vvm", ".context"]]
							],
							"onExit":
							[
								["unloadVVM"]
							],
							"transitions":
							[

							]
						}
					]
				},
				{
					"name": "SettingsCustomizeSaveFlow",
					"states":
					[
						{
							"name": "Idle",
							"transitions":
							[
								{
									"event":   "evt_save_settings",
									"targets": ["SaveSettings"]
								}
							]
						},
						{
							"name": "SaveSettings",
							"onEnter":
							[
								["saveSettings"]
							],
							"transitions":
							[
								{
									"event":   "evt_response_basic_flow",
									"targets": ["HideSettingsCustomize"]
								}
							]
						}
					]
				}
			],
            "transitions":
            [
                {
                    "event":   "evt_exit_settings_customize",
                    "targets": ["HideSettingsCustomize"]
                }
            ]
        }
    ]
}