/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Icon_MatchPreview"
        },
        {
            "commonName": "Panel",
            "name": "MenuMatchSelect",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [        
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 7,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": -30,
                            "marginLeft": 628,
                            "height": 90,
                            "width": 237,
                            "alpha": 1,
                            "path": "views/backgrounds/Green_Effect.swf"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 675,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "text": "Game Settings"
                        }
                    ]
                },
                {
                    "commonName": "Label",
                    "name": "Live",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginBottom": 30,
                    "marginLeft": 0,
                    "fontSize": 14,
                    "fontColor": "0xffffff",
                    "fontFace": "$MONTBLANC_TRIAL_BOLD",
                    "alpha": 0.7,
                    "text": "Game Settings Customize"
                },
                {
                    "commonName": "Panel",
                    "name": "Action",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginBottom": 70,
                    "marginLeft": 0,
                    "width": 350,
                    "children":
                    [
                        {
                            "commonName": "SimpleButton",
                            "alignH": "CENTER",
                            "alignV": "CENTER",
                            "marginLeft": 0,
                            "marginTop": 0,
                            "height": 42,
                            "width": 204,
                            "backgroundImage": "$_ClickToEnterOn3",
                            "backgroundHighlightImage": "$_ClickToEnterOn3",
                            "clickAction": "act_to_settings_customize"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": 0,
                            "marginBottom": 0,
                            "fontSize": 17,
                            "fontColor": "0xFFFFFF",
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "text": "Tap to Settings"
                        }
                    ]
                 },
                 {
                    "commonName": "Label",
                    "name": "Live",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginTop": 105,
                    "marginLeft": 0,
                    "fontSize": 18,
                    "fontColor": "0xCDBB7A",
                    "fontFace": "$FONT_DINPROBOLD",
                    "text": "Overall H2H"
                 },
                 {
                    "commonName": "Panel",
                    "name": "INFO1",
                    "alignV": "BOTTOM",
                    "alignH": "CENTER",
                    "marginBottom": 35.5,
                    "height": 35,
                    "width": 680,
                    "alpha": 0.8,
                    "children":
                    [
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginBottom": 10,
                            "marginLeft": 15,
                            "fontSize": 15,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_DINPROBOLD",
                            "forceCaps": false,
                            "autoTextShadow": true,
                            "width": 650,
                            "autoScroll": true,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_info_match",
                                    "property": "text"
                                }
                            ]
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "INFO2",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "height": 580,
                    "children":
                    [
                        {
                            "commonName": "Image",
                            "name": "LogoTimHome",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": -250,
                            "marginTop": -35,
                            "width": 170,
                            "height": 170,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_logo_tim_home",
                                    "property": "image"
                                }
                            ]
                        },
                        {
                            "commonName": "Label",
                            "name": "NamaTimHome",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": -250,
                            "marginTop": 70,
                            "width": 180,  
                            "fontFace": "$FONT_DINPROBOLD",
                            "fontColor": "$COLOR_WHITE",
                            "fontSize": 20,
                            "forceCaps": false,
                            "autoTextShadow": true,
                            "autoScroll":true,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_home_team_name",
                                    "property": "text"
                                }
                            ]
                        },
                        
                        {
                            "commonName": "Image",
                            "name": "LogoTimAway",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginRight": -250,
                            "marginTop": -35,
                            "width": 170,  
                            "height": 170,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_logo_tim_away",
                                    "property": "image"
                                }
                            ]
                        },
                        {
                            "commonName": "Label",
                            "name": "NamaTimAway",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginRight": -250,
                            "marginTop": 70,
                            "width": 180,  
                            "fontFace": "$FONT_DINPROBOLD",
                            "fontColor": "$COLOR_WHITE",
                            "fontSize": 20,
                            "forceCaps": false,
                            "autoTextShadow": true,
                            "autoScroll":true,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_away_team_name",
                                    "property": "text"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
/*-- Layout Design MVNPROD YouTube --*/