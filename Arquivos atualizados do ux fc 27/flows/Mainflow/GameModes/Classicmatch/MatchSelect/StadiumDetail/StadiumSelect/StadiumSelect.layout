/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Rival"
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
                {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 130,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon1",
                    "clickAction": "act_advance"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 185,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Confirm"
                },
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 7,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 60,
                            "width": 65,
                            "height": 65,
                            "type": "$Icon_Ko"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -2,
                            "marginLeft": 148,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "text": "Kick Off"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 257,
                            "fontSize": 25,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.3,
                            "text": "|"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 299,
                            "fontSize": 22,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.5,
                            "text": "Select Stadium"
                         }
                     ]
                 }
             ]
         },
         {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": 0,
            "width": 580,
            "height": 350,
            "children":
            [
                {
                    "commonName": "Rectangle",
                    "name": "Backgrounds",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "color": "0x151515"
                },
                {
                    "commonName": "Rectangle",
                    "name": "BgAction",
                    "alignV": "BOTTOM",
                    "alignH": "FILL",
                    "height": 50,
                    "color": "0xFFFFFF"
                },
                {
                    "commonName": "Panel",
                    "name": "Preview",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "children":
                    [
                        {
                            "commonName": "Image",
                            "name": "ImgStadium",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginTop": -25,
                            "width": 550,
                            "height": 270,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_stadium_bg",
                                    "property": "image"
                                }
                            ]
                        },
                        {
                            "commonName": "Image",
                            "name": "ImgStadium",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 50,
                            "marginLeft": 30,
                            "width": 80,
                            "height": 80,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_home_team_crest",
                                    "property": "image"
                                }
                            ]
                        },
                        {
                            "commonName": "Label",
                            "name": "StadiumName",
                            "alignV": "BOTTOM",
                            "alignH": "CENTER",
                            "marginLeft": 0,
                            "marginBottom": 16,
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "fontColor": "$COLOR_BLACK",
                            "fontSize": 20,
                            "forceCaps": false,
                            "autoTextShadow": true,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_stadium_name",
                                    "property": "text"
                                }
                            ]
                        },
                        {
                            "commonName": "AssetButton",
                            "alignV": "BOTTOM",
                            "alignH": "LEFT",
                            "marginBottom": 8,
                            "marginLeft": 10,
                            "clickAction": "act_stadium_previous",
                            "buttonAsset": "$ArrowLeft"
                        },
                        {
                            "commonName": "AssetButton",
                            "alignV": "BOTTOM",
                            "alignH": "RIGHT",
                            "marginBottom": 8,
                            "marginRight": 10,
                            "clickAction": "act_stadium_next",
                            "buttonAsset": "$ArrowRight"
                        }
                    ]
                }
            ]
        }
    ]
}
/*-- Layout Design MVNPROD YouTube --*/