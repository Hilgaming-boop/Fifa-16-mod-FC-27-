          "marginBottom": 0,
          "marginLeft": 30,
          "scaleX": 0.6,
          "scaleY": 0.6,
          "icon": "$SimMatchIcon2",
          "clickAction": "act_back"
        },
        {
          "commonName": "Label",
          "alignV": "BOTTOM",
