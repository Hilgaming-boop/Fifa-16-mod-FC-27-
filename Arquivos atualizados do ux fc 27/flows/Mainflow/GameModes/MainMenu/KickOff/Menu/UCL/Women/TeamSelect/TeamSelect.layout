          "fontColor": "0xFFFFFF",
          "fontSize": 20,
          "bindings": [
            {
              "binding": "bnd_away_team_name",
              "property": "text"
            }
          ]
        },
        {
          "commonName": "Image",
          "alignH": "CENTER",
          "alignV": "CENTER",
          "marginTop": 20,
          "scaleX": 0.6,
          "scaleY": 0.6,
          "bindings": [
            {
              "binding": "bnd_away_team_crest",
              "property": "image"
            }
          ]
        },
        {
          "commonName": "StarRating",
          "alignH": "CENTER",
          "alignV": "BOTTOM",
          "marginBottom": 40,
          "size": "medium",
          "bindings": [
            {
              "binding": "bnd_away_team_stars",
              "property": "stars"
            }
          ]
        }
      ]
    },
    {
      "commonName": "Panel",
      "name": "UIFrame",
      "alignV": "CENTER",
      "alignH": "FILL",
      "height": 580,
      "children": [
        {
          "commonName": "GenericButton",
          "alignH": "LEFT",
