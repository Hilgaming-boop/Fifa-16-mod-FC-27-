                            "height": 370,
                            "type": "$Icon_Team_Cup"
                        },
                        {
                            "commonName": "Label",
                            "alignH": "CENTER",
                            "alignV": "TOP",
                            "marginTop": 30,
                            "marginLeft": 0,
