          "alignH": "CENTER",
          "marginBottom": 90,
          "fontSize": 25,
          "fontColor": "0xFFFFFF",
          "fontFace": "$FONT_ORIGIN_KNULEXTRABOLD",
          "text": "Classic Match",
          "alpha": 1
        },

