{
  "commonName": "Panel",
  "name": "rootContainer",
  "alignV": "CENTER",
  "alignH": "CENTER",
  "bindings": [
    {
      "binding": "BND_SCREEN_WIDTH",
      "property": "width"
    },
    {
      "binding": "BND_SCREEN_HEIGHT",
      "property": "height"
    }
  ],
  "animationScripts": [
    {
      "name": "show",
      "script": [
        {
          "anim": "ANIMASI_MASUK_MAINMENU"
        }
      ]
    },
    {
      "name": "",
      "script": [
        {
          "anim": "ANIMASI_KELUAR_MAINMENU"
        }
      ]
    }
  ],
  "style-definitions": {
  
		"TF_TABS_IDLE":
		{
			"alignV": "CENTER",
			"fontFace": "$Title",
			"fontSize": "20",
			"fontColor": "$COLOR_LIGHT_GRAY",
			"alpha": 0.5,
			"width": 240
		},
		"TF_TABS_HIGHLIGHT":
		{
			"alignV": "CENTER",
			"fontFace": "$Title",
			"fontSize": "20",
			"fontColor": "$COLOR_WHITE",
			"width": 240
		},
		"TF_TABS_SELECTED":
		{
			"alignV": "CENTER",
			"fontFace": "$Title",
			"fontSize": "20",
			"fontColor": "$COLOR_WHITE",
			"alpha": 1,
			"width": 200
		}
  },
  "children": [
    {
      "commonName": "Asset",
      "alignV": "FILL",
      "alignH": "FILL",
      "alpha": 1,
      "type": "$Bg_Kick"
    },
    {
      "commonName": "Asset",
      "alignV": "FILL",
      "alignH": "FILL",
      "alpha": 0.2,
      "type": "$Bg_Smoke"
    },
    {
      "commonName": "Panel",
      "name": "UIFrame",
      "alignV": "TOP",
      "alignH": "LEFT",
	  "marginLeft": 30,
	  "marginTop": 30,
      "children": [
        {
          "commonName": "Panel",
          "name": "panel0Group",
          "alignV": "CENTER",
          "alignH": "CENTER",
          "alpha": 0,
          "bindings": [
            {
              "binding": "bnd_panel1_visible",
              "property": "Visible"
            }
          ],
          "animationScripts": [
            {
              "name": "animateCount0",
              "script": [
                {
                  "type": "Direct",
                  "data": {
                    "end": {
                      "alpha": 0,
                      "marginLeft": -50
                    },
                    "duration": 100
                  }
                },
                {
                  "type": "Delay",
                  "data": {
                    "duration": 300
                  }
                },
                {
                  "type": "Direct",
                  "data": {
                    "end": {
                      "alpha": 1,
                      "scaleX": 1,
                      "scaleY": 1,
                      "marginLeft": 0
                    },
                    "duration": 800,
                    "easing": "OutBack"
                  }
                }
              ]
            }
          ],
          "children": [
        {
          "commonName": "Asset",
          "alignV": "TOP",
          "alignH": "LEFT",
          "height": 80,
          "width": 80,
          "marginTop": 0,
          "marginLeft": 20,
          "alpha": 1,
          "type": "$Icon_Ko"
        },
        {
          "commonName": "Label",
          "name": "Live",
          "alignV": "TOP",
          "alignH": "LEFT",
          "marginTop": 20,
          "marginLeft": 120,
          "fontSize": 30,
          "fontColor": "$COLOR_WHITE",
          "fontFace": "$MONTBLANC_TRIAL_BOLD",
          "text": "Home"
        },
        {
          "commonName": "Rectangle",
          "alignV": "TOP",
          "alignH": "LEFT",
          "height": 20,
          "width": 3,
          "marginTop": 30,
          "marginLeft": 230,
          "color": "0xa4a5a9",
          "alpha": 0.4
        }
          ]
        }
      ],
      "behaviors": [
        {
          "commonName": "TriggerScriptBehavior",
          "name": "trigger_fadein_all",
          "script": "animateCount0",
          "target": "panel0Group"
        },
        {
          "commonName": "TriggerOnTrue",
          "name": "trigger_on_true_all",
          "target": "trigger_fadein_all",
          "bindings": [
            {
              "binding": "bnd_animate_count0",
              "property": "value"
            }
          ]
        }
      ]
    },
    {
      "commonName": "Panel",
      "name": "UIFrame",
      "alignV": "TOP",
      "alignH": "LEFT",
	  "marginLeft": 250,
	  "marginTop": 50,
      "children": [
        {
          "commonName": "Panel",
          "name": "panel0Group",
          "alignV": "CENTER",
          "alignH": "CENTER",
          "alpha": 0,
          "bindings": [
            {
              "binding": "bnd_panel1_visible",
              "property": "Visible"
            }
          ],
          "animationScripts": [
            {
              "name": "animateCount0",
              "script": [
                {
                  "type": "Direct",
                  "data": {
                    "end": {
                      "alpha": 0,
                      "marginLeft": 490
                    },
                    "duration": 10
                  }
                },
                {
                  "type": "Delay",
                  "data": {
                    "duration": 300
                  }
                },
                {
                  "type": "Direct",
                  "data": {
                    "end": {
                      "alpha": 1,
                      "scaleX": 1,
                      "scaleY": 1,
                      "marginLeft": 400
                    },
                    "duration": 800,
                    "easing": "OutBack"
                  }
                }
              ]
            }
          ],
          "children": [
        {
          "commonName": "TabBar",
          "alignV": "TOP",
          "alignH": "CENTER",
          "marginTop": 0,
          "marginLeft": -30,
          "width": 750,
          "height": 30,
          "tabs": [
            {
              "label": "Classic Match",
              "clickAction": "act_menu_kick"
            },
            {
              "label": "Role Player",
              "clickAction": "act_menu_beapro"
            },
            {
              "label": "Manager Mode",
              "clickAction": "act_menu_manager"
            },
            {
              "label": "UEFA Champions League",
              "clickAction": "act_menu_ucl"
            }
          ],
          "bindings": [
            {
              "binding": "bnd_tab_index",
              "property": "selectedIndex"
            }
          ]
            }
          ]
        }
      ],
      "behaviors": [
        {
          "commonName": "TriggerScriptBehavior",
          "name": "trigger_fadein_all",
          "script": "animateCount0",
          "target": "panel0Group"
        },
        {
          "commonName": "TriggerOnTrue",
          "name": "trigger_on_true_all",
          "target": "trigger_fadein_all",
          "bindings": [
            {
              "binding": "bnd_animate_count0",
              "property": "value"
            }
          ]
        }
      ]
    },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                }
      ]
    }
  ]
}