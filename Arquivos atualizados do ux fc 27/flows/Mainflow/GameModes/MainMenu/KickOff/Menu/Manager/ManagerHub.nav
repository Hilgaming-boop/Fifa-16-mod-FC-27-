{
    "name": "ManagerHub",
    "onEnter":
    [
        ["setTabContext", [2]],
        ["stateChange", ["ARENA"]],
        ["substateChange", ["SUBSTATE_NONE"]],
        ["invoke", ["evt_show_stage_background"]],
        ["blockingLoadVVM", ["ManagerHub.vvm"]]
    ],
    "onExit":
    [
        ["unloadVVM"]
    ],
    "transitions":
    [
        {
            "event": "evt_coach",
            "targets": ["out_coach"]
        },
        {
            "event": "evt_menu_kick",
            "targets": ["out_menu_kick"]
        },
        {
            "event": "evt_menu_beapro",
            "targets": ["out_menu_beapro"]
        },
        {
            "event": "evt_menu_ucl",
            "targets": ["out_menu_ucl"]
        }
    ]
}