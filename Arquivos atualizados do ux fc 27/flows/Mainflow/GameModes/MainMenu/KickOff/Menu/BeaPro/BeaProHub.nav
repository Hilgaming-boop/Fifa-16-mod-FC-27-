{
    "name": "BeaProHub",
    "onEnter":
    [
        ["setTabContext", [1]],
        ["stateChange", ["ARENA"]],
        ["substateChange", ["SUBSTATE_NONE"]],
        ["invoke", ["evt_show_stage_background"]],
        ["blockingLoadVVM", ["BeaProHub.vvm"]]
    ],
    "onExit":
    [
        ["unloadVVM"]
    ],
    "transitions":
    [
        {
            "event": "evt_beapro",
            "targets": ["out_beapro"]
        },
        {
            "event": "evt_menu_kick",
            "targets": ["out_menu_kick"]
        },
        {
            "event": "evt_menu_manager",
            "targets": ["out_menu_manager"]
        },
        {
            "event": "evt_menu_ucl",
            "targets": ["out_menu_ucl"]
        }
    ]
}