/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Challenge"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.2,
            "type": "$Bg_Smoke"
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
                {
                    "commonName": "Asset",
                    "alignV": "TOP",
                    "alignH": "RIGHT",
                    "marginTop": 12,
                    "marginRight": 125,
                    "height": 20,
                    "width": 140,
                    "type": "$Icon_Hud"
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "RIGHT",
                    "marginTop": 12.5,
                    "marginRight": 82,
                    "fontSize": 13,
                    "fontColor": "$COLOR_WHITE",
                    "fontFace": "$KnulExtraBold",
                    "text": "ALPHATRIX             Level 48          98/1,000"
                },
                {
                    "commonName": "Image",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginLeft": 400,
                    "marginTop": 30,
                    "scaleX":0.20,
                    "scaleY":0.20,
                    "bindings": 
                    [
                        {
                            "binding": "bnd_player3d",
                            "property": "image"
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 7,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 60,
                            "width": 65,
                            "height": 65,
                            "type": "$Icon_C"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -2,
                            "marginLeft": 140,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "text": "Clubs"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 215,
                            "fontSize": 25,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.3,
                            "text": "|"
                        },
                        {
                            "commonName": "LiveTile",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginBottom": 7,
                            "marginLeft": 245,
                            "width": 300,
                            "height": 30,
                            "clickAction": "act_legends",
                            "headline": ["Legends Clubs"]
                        },
                        {
                            "commonName": "LiveTile",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginBottom": 7,
                            "marginLeft": 430,
                            "width": 300,
                            "height": 30,
                            "clickAction": "act_mensteams",
                            "headline": ["Mens Clubs"]
                        },
                        {
                            "commonName": "LiveTile",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginBottom": 7,
                            "marginLeft": 585,
                            "width": 300,
                            "height": 30,
                            "clickAction": "act_womensteams",
                            "headline": ["Womens Clubs"]
                        }
                    ]
                }
            ]
        }
    ]
}
/*-- Layout Design MVNPROD YouTube --*/