{
    "name": "MenuHub",
    "initial":
    {
        "targets": ["RedirectMenuHub"]
    },
    "states":
    [
        {
            "name": "RedirectMenuHub",
            "onEnter":
            [
                  ["blockingLoadVVM", ["MenuHub.vvm"]]
            ],
            "onExit":
            [
                ["unloadVVM"]
            ],
            "transitions":
            [
                {
                    "event": "evt_back",
                    "targets": ["out_exit_gamemode"]
                },
                {
                    "event": "evt_ligue1",
                    "targets": ["Ligue1"]
                },
                {
                    "event": "evt_ligapremier",
                    "targets": ["Ligapremier"]
                },
                {
                    "event": "evt_laliga",
                    "targets": ["Laliga"]
                },
                {
                    "event": "evt_serie",
                    "targets": ["Serie"]
                },
                {
                    "event": "evt_brasil",
                    "targets": ["Brasil"]
                }
            ]
        },
        {
            "name": "Ligue1",
            "type": "external",
            "file": "/flows/mainflow/GameModes/QuickCup/Ligue1/TeamSelect/TeamSelect.nav",
            "outputs":
            {
                "out_exit_gamemode": "RedirectMenuHub"
            }
        },
        {
            "name": "Ligapremier",
            "type": "external",
            "file": "/flows/mainflow/GameModes/QuickCup/Ligapremier/TeamSelect/TeamSelect.nav",
            "outputs":
            {
                "out_exit_gamemode": "RedirectMenuHub"
            }
        },
        {
            "name": "Laliga",
            "type": "external",
            "file": "/flows/mainflow/GameModes/QuickCup/Laliga/TeamSelect/TeamSelect.nav",
            "outputs":
            {
                "out_exit_gamemode": "RedirectMenuHub"
            }
        },
        {
            "name": "Serie",
            "type": "external",
            "file": "/flows/mainflow/GameModes/QuickCup/Serie/TeamSelect/TeamSelect.nav",
            "outputs":
            {
                "out_exit_gamemode": "RedirectMenuHub"
             }
        },
        {
            "name": "Brasil",
            "type": "external",
            "file": "/flows/mainflow/GameModes/QuickCup/Brasil/TeamSelect/TeamSelect.nav",
            "outputs":
            {
                "out_exit_gamemode": "RedirectMenuHub"
            }
        }
    ]
}