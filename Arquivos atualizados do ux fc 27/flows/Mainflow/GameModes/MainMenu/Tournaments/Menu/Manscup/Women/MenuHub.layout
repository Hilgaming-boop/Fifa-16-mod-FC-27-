/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "behaviors":
    [
        {
            "commonName": "SquadCustomizationBehavior",
            "actionName": "act_mvnprod",
            "buttonContainer": "MvnprodButton"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_kick"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.8,
            "type": "$Bg_Smoke"
            },
                    {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -240,
                            "marginLeft": 60,
                            "width": 65,
                            "height": 65,
                            "type": "$Icon_T"
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
                {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
                {
                    "commonName": "Label",
                    "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -210,
                    "marginLeft": 120,
                    "fontSize": 17,
                    "fontColor": "$COLOR_WHITE",
                    "fontFace": "$CruyffSans-Regular",
                    "text": "Tournament > Domestic Cup > Women's League"
                }
            ]
        },
        {
            "commonName": "Panel",
            "name": "BagianInfo",
            "alignV": "CENTER",
            "alignH": "LEFT",
            "marginLeft": 120,
            "marginTop": -30,
            "width": 680,
            "height": 325,
            "children":
            [
                {
                    "commonName": "Rectangle",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "color": "0x1C1C1C",
                    "alpha": 1
                },
                {
                    "commonName": "Panel",
                    "name": "Info1",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "bindings":
                    [
                        {
                            "binding": "bnd_tab1_visible",
                            "property": "visible"
                        }
                    ],
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "FILL",
                            "alignH": "FILL",
                            "type": "$ANIM BARCLAYS WSL"
                        },
                        {
                            "commonName": "Asset",
                            "name": "icon",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": 600,
                            "marginBottom": 0,
                            "width": 400,
                            "height": 320,
                            "type": "$England_Flago"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": 7,
                            "marginLeft": 20,
                            "fontFace": "$CruyffSans-Bold",
                            "fontSize": 30,
                            "fontColor": "$COLOR_WHITE",
                            "text": "Barclays WSL"
                        },
                        {
                        "commonName": "Label",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": 50,
                            "marginLeft": 70,
                            "fontFace": "$CruyffSans-Regular",
                            "fontSize": 16,
                            "fontColor": "$COLOR_WHITE",
                            "text": "England"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": 80,
                            "marginLeft": 20,
                            "fontFace": "$CruyffSans-Regular",
                            "fontSize": 17,
                            "fontColor": "$COLOR_WHITE",
                            "width": 630,
                            "multiline": true,
                            "leading": 1,
                            "alpha": 1,
                            "text": "The first women's football match in England dates back to 1895.The Women's Football Association was created in 1969. The FA Women's Super League was rebranded in 2011 replacing the Women's Premier League National Division. The league started with 8 teams and expanded to 12 teams. The most successful team in the history is Arsenal who won 15 league titles and 14 FA Women's Cups."
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "Info2",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "bindings":
                    [
                        {
                            "binding": "bnd_tab2_visible",
                            "property": "visible"
                        }
                    ],
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "FILL",
                            "alignH": "FILL",
                            "type": "$ANIM D1"
                        },
                        {
                            "commonName": "Asset",
                            "name": "icon",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": 600,
                            "marginBottom": 0,
                            "width": 400,
                            "height": 320,
                            "type": "$French_Flago"
                            },
                        {
                            "commonName": "Label",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": 7,
                            "marginLeft": 20,
                            "fontFace": "$CruyffSans-Bold",
                            "fontSize": 30,
                            "fontColor": "$COLOR_WHITE",
                            "text": "Arkema PL"
                        },
                        {
                        "commonName": "Label",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": 50,
                            "marginLeft": 70,
                            "fontFace": "$CruyffSans-Regular",
                            "fontSize": 16,
                            "fontColor": "$COLOR_WHITE",
                            "text": "France"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": 80,
                            "marginLeft": 20,
                            "fontFace": "$CruyffSans-Regular",
                            "fontSize": 17,
                            "fontColor": "$COLOR_WHITE",
                            "width": 630,
                            "multiline": true,
                            "leading": 1,
                            "alpha": 1,
                            "text": "The Premiere Ligue is a 12-team competition first organized by the French Football Federation (FFF) in 1974. Stade de Reims won the first title in 1974-75. At the time of its foundation, the league consisted of 8 teams, and in 1992 it expanded to 12. Historically, Olympique Lyonnais dominates the competition having won 14 consecutive titles between 2007 and 2020."
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "Info3",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "bindings":
                    [
                        {
                            "binding": "bnd_tab3_visible",
                            "property": "visible"
                        }
                    ],
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "FILL",
                            "alignH": "FILL",
                            "type": "$ANIM LIGA F"
                        },
                        {
                            "commonName": "Asset",
                            "name": "icon",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": 600,
                            "marginBottom": 0,
                            "width": 400,
                            "height": 320,
                            "type": "$Spain_Flago"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "TOP",
