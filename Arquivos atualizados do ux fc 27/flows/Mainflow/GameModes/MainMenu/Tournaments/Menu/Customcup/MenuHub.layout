                    "text": "Back"
                },
                {
                "commonName": "Rectangle",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginTop": 0,
                    "marginLeft": 0,
                    "width": 900,
                    "height": 500,
                    "color": "0x1C1C1C",
