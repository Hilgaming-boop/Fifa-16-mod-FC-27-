{
    "name": "CreditsHub",
    "initial":
    {
        "targets": ["RedirectCreditsHub"]
    },
    "states":
    [
		{
            "name": "RedirectCreditsHub",
            "onEnter":
            [
                ["blockingLoadVVM", ["CreditsHub.vvm"]]
            ],
            "onExit":
            [
                ["unloadVVM"]
            ],
            "transitions":
            [
                {
                    "event": "evt_back",
                    "targets": ["out_exit_gamemode"]
                },
                {
                    "event": "evt_youtube_mountsa",
                    "targets": ["YoutubeMountsa"]
                },
                {
                    "event": "evt_instagram_mountsa",
                    "targets": ["InstagramMountsa"]
                }

            ]
        },
        {
            "name": "YoutubeMountsa",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/MainMenu/MenuCustomize/Credits/YoutubeMountsa/CreditsHub.nav",
            "outputs":
            {
                "out_exit_gamemode": "CreditsHub"
            }
        },
        {
            "name": "InstagramMountsa",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/MainMenu/MenuCustomize/Credits/InstagramMountsa/CreditsHub.nav",
            "outputs":
            {
                "out_exit_gamemode": "CreditsHub"
            }
        }

    ]
}