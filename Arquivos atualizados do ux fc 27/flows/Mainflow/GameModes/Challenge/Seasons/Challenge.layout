                    "alignH": "CENTER",
                    "marginTop": 150,
                    "marginLeft": 0,
                    "fontSize": 20,
                    "fontColor": "$COLOR_WHITE",
                    "fontFace": "$FONT_ORIGIN_NORMAL",
                    "textAlignH": "CENTER",
                    "width": 350,
                    "multiline": true,
                    "leading": 1,
                    "text": "Setting up team formation creates a good game strategy to win the match",
                    "alpha": 0.7
                },
                {
                    "commonName": "Panel",
                    "name": "Action",
                    "alignV": "BOTTOM",
                    "alignH": "CENTER",
                    "marginBottom": 100,
                    "marginLeft": 0,
                    "width": 350,
                    "children":
                    [
                        {
                            "commonName": "SimpleButton",
                            "alignH": "CENTER",
                            "alignV": "CENTER",
                            "marginLeft": 0,
                            "marginTop": 0,
                            "height": 100,
                            "width": 200,
                            "backgroundImage": "$Tab_Action_White",
                            "backgroundHighlightImage": "$Tab_Action_Green",
                            "clickAction": "act_squad"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": 0,
                            "marginBottom": -1,
                            "fontSize": 17,
                            "fontColor": "0x151514",
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "text": "Tap to Squad"
                        }
                    ]
                }
            ]
