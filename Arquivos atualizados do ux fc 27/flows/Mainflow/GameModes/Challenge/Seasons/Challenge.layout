            "children":
            [
                {
                   "commonName": "Label",
                   "alignV": "TOP",
                   "alignH": "CENTER",
                   "marginTop": 100,
                   "marginLeft": 0,
                   "fontSize": 20,
                   "fontColor": "$COLOR_WHITE",
                   "fontFace": "$MONTBLANC_TRIAL_BOLD",
                   "text": "SQUAD"
                },
                {
                    "commonName": "Label",
