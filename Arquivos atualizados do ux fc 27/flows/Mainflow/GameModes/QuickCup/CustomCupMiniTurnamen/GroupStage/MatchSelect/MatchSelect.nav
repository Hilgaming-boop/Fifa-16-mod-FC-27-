{
    "name": "MatchSelect",
    "initial": {
        "targets": ["MenuMatchSelect"]
    },
    "states": [
        {
            "name": "MenuMatchSelect",
            "onEnter": [
                ["blockingLoadVVM", ["MatchSelect.vvm"]]
            ],
            "onExit": [
                ["unloadVVM"]
            ],
            "states": [
                {
                    "name": "RedirectTab1",
                    "states": [
                        {
                            "name": "Tab1",
                            "onEnter": [
								["setTabContext", [0]],
                                ["blockingLoadVVM", ["/Flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/Tab1.vvm"]]
                            ],
                            "onExit": [
                                ["unloadVVM"]
                            ]
                        }
                    ],
                    "transitions": [
                        {"event": "evt_tab2", "targets": ["RedirectTab2"]},
                        {"event": "evt_tab3", "targets": ["RedirectTab3"]},
                        {"event": "evt_tab4", "targets": ["RedirectTab4"]}
                    ]
                },
                {
                    "name": "RedirectTab2",
                    "states": [
                        {
                            "name": "Tab2",
                            "onEnter": [
								["setTabContext", [1]],
                                ["blockingLoadVVM", ["/Flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/Tab2.vvm"]]
                            ],
                            "onExit": [
                                ["unloadVVM"]
                            ],
                            "states": [
                                {
                                    "name": "RedirectTab2sub1",
                                    "states": [
                                        {
                                            "name": "Tab2sub1",
                                            "onEnter": [
                                                ["blockingLoadVVM", ["/flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/Tab2sub1.vvm"]]
                                            ],
                                            "onExit": [
                                                ["unloadVVM"]
                                            ]
                                        }
                                    ],
                                    "transitions": [
                                        {"event": "evt_tab2sub2", "targets": ["RedirectTab2sub2"]}
                                    ]
                                },
                                {
                                    "name": "RedirectTab2sub2",
                                    "states": [
                                        {
                                            "name": "Tab2sub2",
                                            "onEnter": [
                                                ["blockingLoadVVM", ["/flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/Tab2sub2.vvm"]]
                                            ],
                                            "onExit": [
                                                ["unloadVVM"]
                                            ]
                                        }
                                    ],
                                    "transitions": [
                                        {"event": "evt_tab2sub1", "targets": ["RedirectTab2sub1"]}
                                    ]
                                }
                            ]
                        }
                    ],
                    "transitions": [
                        {"event": "evt_tab1", "targets": ["RedirectTab1"]},
                        {"event": "evt_tab3", "targets": ["RedirectTab3"]},
                        {"event": "evt_tab4", "targets": ["RedirectTab4"]}
                    ]
                },
{
    "name": "RedirectTab3",
    "states": [
        {
            "name": "Tab3",
            "onEnter": [
				["setTabContext", [2]],
                ["blockingLoadVVM", ["/Flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/Tab3.vvm"]]
            ],
            "onExit": [
                ["unloadVVM"]
