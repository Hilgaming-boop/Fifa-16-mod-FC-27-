                            ],
                            "onExit": [
                                ["unloadVVM"]
                            ]
                        }
                    ],
                    "transitions": [
                        {"event": "evt_tab3sub1", "targets": ["RedirectTab3sub1"]},
                        {"event": "evt_tab3sub3", "targets": ["RedirectTab3sub3"]}
                    ]
                },
                {
                    "name": "RedirectTab3sub3",
                    "states": [
                        {
                            "name": "Tab3sub3",
