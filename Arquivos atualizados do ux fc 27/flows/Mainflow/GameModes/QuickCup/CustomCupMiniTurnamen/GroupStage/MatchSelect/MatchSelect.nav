                                    "name": "RedirectTab4sub2",
                                    "states": [
                                        {
                                            "name": "Tab4sub2",
                                            "onEnter": [
                                                ["blockingLoadVVM", ["/flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/Tab4sub2.vvm"]]
                                            ],
