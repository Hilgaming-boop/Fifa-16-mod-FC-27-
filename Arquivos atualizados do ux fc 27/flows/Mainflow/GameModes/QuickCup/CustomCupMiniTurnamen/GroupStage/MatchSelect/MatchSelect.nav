        }
    ],
    "transitions": [
        {"event": "evt_tab1", "targets": ["RedirectTab1"]},
        {"event": "evt_tab2", "targets": ["RedirectTab2"]},
        {"event": "evt_tab4", "targets": ["RedirectTab4"]}
    ]
},
                {
                    "name": "RedirectTab4",
                    "states": [
                        {
                            "name": "Tab4",
                            "onEnter": [
								["setTabContext", [3]],
                                ["blockingLoadVVM", ["/Flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/Tab4.vvm"]]
                            ],
                            "onExit": [
                                ["unloadVVM"]
                            ],
                            "states": [
                                {
                                    "name": "RedirectTab4sub1",
                                    "states": [
                                        {
                                            "name": "Tab4sub1",
                                            "onEnter": [
                                                ["blockingLoadVVM", ["/flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/Tab4sub1.vvm"]]
                                            ],
                                            "onExit": [
