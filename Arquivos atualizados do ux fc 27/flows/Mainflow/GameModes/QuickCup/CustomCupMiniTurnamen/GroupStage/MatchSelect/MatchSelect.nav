                        {"event": "evt_tab2", "targets": ["RedirectTab2"]},
                        {"event": "evt_tab3", "targets": ["RedirectTab3"]}
                    ]
                }
            ],
            "transitions": [
                {"event": "evt_back", "targets": ["out_exit_gamemode1"]},
                {"event": "evt_advance", "targets": ["SelectSideFlow"]},
                {"event": "evt_squad", "targets": ["Squad"]},
                {"event": "evt_force_reset_tournament", "targets": ["Restart"]},
                {"event": "evt_standing", "targets": ["Standing"]},
                {"event": "evt_fixtures", "targets": ["Fixtures"]},
                {"event": "evt_topscores", "targets": ["GoalScores"]},
				{"event": "evt_auto_simulate_matchday","targets": ["MenuMatchSelect"]},
				{"event": "evt_to_sim_match", "targets": ["SimulateMatch"] }
            ]
        },
        {
            "name": "SelectSideFlow",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/SelectSide/SelectSide.nav",
            "outputs": {
                "out_exit_gamemode": "MatchSelect",
                "out_exit_gamemode1": "MatchSelect"
            }
        },
        {
            "name": "MatchPlay",
            "type": "external",
            "file": "/flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/MatchPlay/MatchPlay.nav",
            "outputs": {
                "out_exit_gamemode": "MatchSelect",
                "out_exit_gamemode1": "MatchSelect"
            }
        },
		{
			"name": "SimulateMatch",
			"type": "external",
			"file": "/flows/mainflow/GameModes/QuickCup/CustomCupMiniTurnamen/PlaySim/Match.nav",
			"outputs": {
				"out_back": "MatchSelect"
			}
		},
        {
            "name": "KitSelect",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/QuickCup/CustomCupMiniTurnamen/GroupStage/KitSelect/KitSelect.nav",
            "outputs": {
                "out_exit_gamemode": "MatchSelect",
                "out_exit_gamemode1": "MatchSelect"
            }
        },
        {
            "name": "Squad",
            "type": "external",
            "file": "/flows/MainFlow/GameModes/QuickCup/CustomCupMiniTurnamen/Squad/Squad.nav",
            "outputs":
            {
                "out_exit_gamemode": "RedirectTab2"
                
            }
        },
        {
            "name": "Restart",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/QuickCup/CustomCupMiniTurnamen/Restart/Restart.nav",
            "outputs": {
                "out_exit_gamemode": "out_exit_gamemode1"
            }
        },
        {
            "name": "GoalScores",
            "type": "external",
            "file": "/flows/MainFlow/GameModes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/Goalscorers/Goalscorers.nav",
            "outputs": {
                "out_exit_gamemode": "RedirectTab3sub2",
                "out_exit_gamemode1": "RedirectTab3sub2"
            }
        },
        {
            "name": "Standing",
            "type": "external",
            "file": "/flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/standings/standings.nav",
            "outputs": {
                "out_exit_gamemode": "RedirectTab3",
                "out_exit_gamemode1": "RedirectTab3"
            }
        },
        {
            "name": "Fixtures",
            "type": "external",
            "file": "/flows/mainflow/gamemodes/QuickCup/CustomCupMiniTurnamen/GroupStage/MatchSelect/TabActive/fixtures/standings.nav",
            "outputs": {
                "out_exit_gamemode": "RedirectTab3sub3",
                "out_exit_gamemode1": "RedirectTab3sub3"
            }
        }
    ]
}


