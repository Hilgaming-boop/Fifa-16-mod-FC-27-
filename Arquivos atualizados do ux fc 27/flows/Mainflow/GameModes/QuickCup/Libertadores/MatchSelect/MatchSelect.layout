{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
  "style-definitions": {
  
		"TF_TABS_IDLE":
		{
			"alignV": "CENTER",
			"fontFace": "$Title",
			"fontSize": "23",
			"fontColor": "$COLOR_LIGHT_GRAY",
			"alpha": 0.7,
			"width": 250
		},
		"TF_TABS_HIGHLIGHT":
		{
			"alignV": "CENTER",
			"fontFace": "$Title",
			"fontSize": "23",
			"fontColor": "$COLOR_WHITE",
			"width": 250
		},
		"TF_TABS_SELECTED":
		{
			"alignV": "CENTER",
			"fontFace": "$Title",
			"fontSize": "23",
			"fontColor": "$COLOR_WHITE",
			"alpha": 1,
			"width": 250
		}
  },
    "children":
    [
        {
            "commonName": "Image",
            "alignV": "FILL",
            "alignH": "FILL",
            "bindings":
			[
				{
					"binding": "bnd_cup_bg",
					"property": "image"
				}
            ]
        },
    {
      "commonName": "Asset",
      "alignV": "FILL",
      "alignH": "FILL",
      "marginBottom": -10,
      "type": "$Bg_Gradiant1"
    },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 7,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 60,
                            "width": 65,
                            "height": 65,
                            "type": "$Icon_T"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -2,
                            "marginLeft": 130,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "text": "Home"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 215,
                            "fontSize": 25,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.3,
                            "text": "|"
                        },
						{
							"commonName": "TabBar",
							"alignV": "TOP",
							"alignH": "LEFT",
							"marginTop": -7,
							"marginLeft": 240,
							"width": 400,
							"height": 30,
							"tabs": [
								{
									"label": "Central",
									"clickAction": "act_tab1"
								},
								{
									"label": "Squad",
									"clickAction": "act_tab2"
								},
								{
									"label": "Office",
									"clickAction": "act_tab3"
								},
								{
									"label": "Customise",
									"clickAction": "act_tab4"
								}
							],
							"bindings": [
								{
									"binding": "bnd_tab_index",
									"property": "selectedIndex"
								}
							]
						}
                    ]
                },
                {
                    "commonName": "Image",
                    "name": "HomeCrest",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 0,
                    "marginLeft": 1000,
                    "width": 30,
                    "height": 30,
                    "bindings":
                    [
                        {
                            "binding": "bnd_home_crest",
                            "property": "image"
                        }
                    ]
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 5,
                    "marginLeft": 1035,
                    "fontSize": 20,
                    "fontFace": "$FONT_DINPRO",
                    "fontColor": "0xffffff",
                    "textAlignH": "LEFT",
                    "alpha": 0.5,
                    "bindings":
                    [
                        {
                            "binding": "bnd_home_team",
                            "property": "text"
                        }
                    ]
                }
            ]
        }
    ]
}