{
  "name": "MatchPlay",
  "initial": {
    "targets": ["MenuMatchPlay"]
  },
  "states": [
    {
      "name": "MenuMatchPlay",
      "initial": {
        "targets": ["RedirectAllMatchPlay"]
      },
      "onEnter": [
        ["blockingLoadVVM", ["MatchPlay.vvm"]]
      ],
      "onExit": [
        ["unloadVVM"]
      ],
      "states": [
        {
          "name": "RedirectAllMatchPlay",
          "initial": {
            "targets": ["AllMatchPlay"]
          },
          "states": [
            {
              "name": "AllMatchPlay",
              "onEnter": [
                ["blockingLoadVVM", [
                  "/flows/MainFlow/GameModes/QuickCup/CustomCup4Gruop/GroupStage/MatchSelect/TabActive/MatchPlay/AllMatchPlay/AllMatchPlay.vvm"
                ]]
              ],
              "onExit": [
                ["unloadVVM"]
              ]
            }
          ]
        }
      ],
      "transitions": [
        { "event": "evt_back", "targets": ["out_exit_gamemode1"] },
        { "event": "evt_customize", "targets": ["Customize"] },
        { "event": "evt_advance", "targets": ["PlayMatch"] },
        { "event": "evt_squad", "targets": ["Squad"] },
        { "event": "evt_refresh_on_resize", "targets": ["MenuMatchPlay"] }
      ]
    },
        {
            "name": "PlayMatch",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/QuickCup/CustomCup4Gruop/PlayMatch/Match.nav",
            "outputs":
            {
                "out_exit_gamemode": "out_exit_gamemode1"
            }
        },
        {
            "name": "Customize",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/QuickCup/CustomCup4Gruop/GroupStage/KitSelect/KitSelect.nav",
            "outputs":
            {
                "out_exit_gamemode": "MatchPlay"
            }
        },
        {
            "name": "Squad",
            "type": "external",
            "file": "/flows/MainFlow/GameModes/QuickCup/CustomCup4Gruop/Squad/Squad.nav",
            "outputs": {
                "out_exit_gamemode": "MatchPlay"
            }
        }
    ]
}