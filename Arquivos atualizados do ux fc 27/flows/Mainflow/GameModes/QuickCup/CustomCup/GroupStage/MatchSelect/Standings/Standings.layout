{
    "commonName": "Panel",
    "name": "rootContainer",
	"alignV": "CENTER",
    "alignH": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        },
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        }
    ],
       "animationScripts":
    [
        {
            "name": "show",
            "script":
            [
                {
                    "anim": "TUTORIAL_TRANSITION_IN"
                }
            ]
        },
        {
            "name": "hide",
            "script":
            [
                {
                    "anim": "TUTORIAL_TRANSITION_OUT"
                }
            ]
        }
    ],
    "style-definitions": {

		"TF_TABS_IDLE":
		{
			"alignV": "CENTER",
			"fontFace": "$Title",
			"fontSize": "23",
			"fontColor": "$COLOR_LIGHT_GRAY",
			"alpha": 0.7,
			"width": 250
		},
		"TF_TABS_HIGHLIGHT":
		{
			"alignV": "CENTER",
			"fontFace": "$Title",
			"fontSize": "23",
			"fontColor": "$COLOR_WHITE",
			"width": 250
		},
		"TF_BUTTON_PLAYMODEOFF":
		{
			"alignV": "CENTER",
			"fontFace": "$Title",
			"fontSize": "20",
			"fontColor": "$COLOR_WHITE",
			"alpha": 0.7,
			"width": 200
		}
  },
  "behaviors":
    [
        {
            "commonName": "TickerNavPublisher",
            "alignH": "LEFT",
            "icon": "",
            "actionName": "act_back",
            "label": ""
        },
        {
            "commonName": "TickerNavPublisher",
            "alignH": "LEFT",
            "icon": "",
            "actionName": "act_bracketOff",
            "label": ""
        }
    ],
    "children":
    [
        {
            "commonName": "Image",
            "alignV": "FILL",
            "alignH": "FILL",
            "bindings":
            [
                {
                    "binding": "bnd_bg_tour",
                    "property": "image"
                }
			]
        },
        {
            "commonName": "Panel",
            "name": "Actions",
            "alignV": "FILL",
            "alignH": "FILL",
            "children":
            [
                {
                    "commonName": "GenericButton",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 15,
                    "marginLeft": 50,
                    "scaleX": 0.8,
                    "scaleY": 0.8,
                    "label": "",
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 15,
                    "marginLeft": 130,
                    "forceCaps": false,
                    "fontSize": 18,
                    "fontFace": "$FONT_CRUYFFSANSREGULAR",
                    "fontColor": "$COLOR_WHITE",
                    "text": "Back"
                }
            ]
        },
        {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 40,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 60,
                            "width": 65,
                            "height": 65,
                            "type": "$Icon_T"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -2,
                            "marginLeft": 130,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "text": "Home"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 215,
                            "fontSize": 25,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.3,
                            "text": "|"
                        }
					]
				},
        {
            "commonName": "Panel",
            "name": "BagianAction",
            "alignV": "TOP",
            "alignH": "FILL",
            "marginTop": 40,
            "height": 30,
            "children":
            [
                {
                    "commonName": "SimpleButton",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 301,
                    "height": 30,
                    "width": 100,
                    "label": "Group Stage",
                    "clickAction": "act_tab1",
                    "textStyles": [ "TF_BUTTON_PLAYMODEOFF" ]
                },
                {
                    "commonName": "SimpleButton",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 425,
                    "height": 30,
                    "width": 110,
                    "label": "Round Of 32",
                    "clickAction": "act_tab2",
                    "textStyles": [ "TF_BUTTON_PLAYMODEOFF" ]
                },
                {
                    "commonName": "SimpleButton",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 558,
                    "height": 30,
                    "width": 100,
                    "label": "Round Of 16",
                    "clickAction": "act_tab3",
                    "textStyles": [ "TF_BUTTON_PLAYMODEOFF" ]
                },
                {
                    "commonName": "SimpleButton",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 690,
                    "height": 30,
                    "width": 100,
                    "label": "Quarter-Finals",
                    "clickAction": "act_tab4",
                    "textStyles": [ "TF_BUTTON_PLAYMODEOFF" ]
                },
                {
                    "commonName": "SimpleButton",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 811,
                    "height": 30,
                    "width": 110,
                    "label": "Semi-Finals",
                    "clickAction": "act_tab5",
                    "textStyles": [ "TF_BUTTON_PLAYMODEOFF" ]
                },
                {
                    "commonName": "SimpleButton",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 902,
                    "height": 30,
                    "width": 110,
                    "label": "Final",
                    "clickAction": "act_tab6",
                    "textStyles": [ "TF_BUTTON_PLAYMODEOFF" ]
				}
            ]
        },
        {
            "commonName": "Panel",
            "name": "Info",
            "alignV": "TOP",
            "alignH": "RIGHT",
            "marginTop": 40,
            "marginRight": 150,
            "width": 180,
            "height": 30,
            "children":
            [
                {
                    "commonName": "Label",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginTop": 0,
                    "marginLeft": 45,
                    "width": 130,
                    "autoScroll": true,
                    "fontSize": 18,
                    "fontColor": "0xAAAAAA",
                    "fontFace": "$FONT_CRUYFFSANSREGULAR",
                    "bindings":
                    [
                        {
                            "binding": "bnd_tour_label",
                            "property": "text"
                        }
		            ]
                },
                {
                    "commonName": "Image",
                    "name": "CupLogo",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginTop": 0,
                    "marginLeft": 0,
                    "width": 40,
                    "height": 40,
                    "bindings":
                    [
                        {
                            "binding": "bnd_tour_logo",
                            "property": "image"
                        }
                    ]
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 40,
                    "marginLeft": 1190,
                    "fontSize": 16,
                    "fontFace": "$FONT_DINPRO",
                    "fontColor": "0xffffff",
                    "alpha": 0.5,
					"width": 100,
					"autoScroll": true,
					"autoTextShadow": true,
                    "bindings":
                    [
                        {
                            "binding": "bnd_info_progres",
                            "property": "text"
                        }
		            ]
                }
            ]
        }
    ]
}