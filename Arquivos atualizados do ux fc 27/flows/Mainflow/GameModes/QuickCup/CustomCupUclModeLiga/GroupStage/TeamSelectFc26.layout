{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts": [
    {
      "name": "show",
      "script": [
        {
          "anim": "OVERLAY_TRANSITION_IN"
        }
      ]
    },
    {
      "name": "hide",
      "script": [
        {
          "anim": "OVERLAY_TRANSITION_OUT"
        }
      ]
    }
  ],
