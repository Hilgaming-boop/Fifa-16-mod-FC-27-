{
    "commonName": "Panel",
    "alignH": "FILL",
    "alignV": "FILL",
    "name": "insOuterContainer",
    "animationScripts": [
        {
            "name": "show",
            "script": [
                {
                    "anim": "SCREEN_TRANSITION_IN"
                }
            ]
        },
        {
            "name": "hide",
            "script": [
                {
                    "anim": "SCREEN_TRANSITION_OUT"
                }
            ]
        }
    ],
    "behaviors":
    [
        {
            "commonName": "SquadCustomizationBehavior",
            "actionName": "act_btn_click",
            "buttonContainer": "insButtonsOptionsBot"
        },
        {
            "commonName": "SquadTeamManagementBehavior",
            "starting11": "insSquad.insSquadLayout",
            "subsAndReserves": "insSquad.insItemDock",
            "actionName": "act_swap_players"
        },
        {
            "commonName": "SquadPlayerComparisonBehavior",
            "comparisonTargetNames":
            [
                "insSquad.insSquadLayout",
                "insSquad.insItemDock"
            ],
            "actionName": "act_compare_players"
        }
    ],
    "style-definitions": {
        "TF_TEAM_NAME": {
            "text-format": "fow.style.SquadStyle.TF_FORMATION_NAME"
        },
        "TF_TEAM_STATS_LABEL": {
            "text-format": "fow.style.SquadStyle.TF_COMBOBOX_LABEL"
        },
        "TF_TEAM_STATS": {
            "text-format": "fow.style.SquadStyle.TF_COMBOBOX_LABEL"
        }
    },
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
