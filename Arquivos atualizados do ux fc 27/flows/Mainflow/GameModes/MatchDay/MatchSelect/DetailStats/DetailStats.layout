/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Icon_DetailsStats"
        },
        {
            "commonName": "Panel",
            "name": "MenuMatchSelect",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [        
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 7,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": -30,
                            "marginLeft": 1010,
                            "height": 90,
                            "width": 224,
                            "alpha": 1,
                            "path": "views/backgrounds/Green_Effect.swf"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 1052,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "text": "Detailed Stats"
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "Action",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginBottom": -230,
                    "marginLeft": 0,
                    "width": 350,
                    "children":
                    [
                        {
                            "commonName": "SimpleButton",
                            "alignH": "CENTER",
                            "alignV": "CENTER",
                            "marginLeft": 0,
                            "marginTop": 0,
                            "height": 42,
                            "width": 204,
                            "backgroundImage": "$_ClickToEnterOn3",
                            "backgroundHighlightImage": "$_ClickToEnterOn3",
                            "clickAction": "act_detail"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": 0,
                            "marginBottom": 0,
                            "fontSize": 17,
                            "fontColor": "0xFFFFFF",
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "text": "Tap to Details"
                        }
                    ]
                 },
                 {
                    "commonName": "Panel",
                    "name": "Preview",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
