/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Kick"
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
                {
                    "commonName": "Asset",
                    "alignV": "TOP",
                    "alignH": "RIGHT",
                    "marginTop": 12,
                    "marginRight": 125,
                    "height": 20,
                    "width": 140,
                    "type": "$Icon_Hud"
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "RIGHT",
                    "marginTop": 12.5,
                    "marginRight": 82,
                    "fontSize": 13,
                    "fontColor": "$COLOR_WHITE",
                    "fontFace": "$KnulExtraBold",
                    "text": "ALPHATRIX             Level 48           98/1,000"
                },
                {
                    "commonName": "Image",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginLeft": 400,
                    "marginTop": 30,
                    "scaleX":0.20,
                    "scaleY":0.20,
                    "bindings": 
                    [
                        {
                            "binding": "bnd_player3d",
                            "property": "image"
                        }
                    ]
               },
               {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 7,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 60,
                            "width": 65,
                            "height": 65,
                            "type": "$Icon_Dm"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -2,
                            "marginLeft": 148,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "text": "Daily Match"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 300,
                            "fontSize": 25,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.3,
                            "text": "|"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 340,
                            "fontSize": 22,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.5,
                            "text": "Select Match"
                         }
                     ]
                 }
            ]
        },
        {
            "commonName": "Panel",
            "name": "BagianMenu",
            "alignV": "CENTER",
            "alignH": "LEFT",
            "width": 650,
            "height": 430,
            "marginTop": 20,
            "marginLeft": 100,
            "children":
            [
                {
                    "commonName": "Rectangle",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "color": "0x1C1C1C",
                    "cornerRaduis": 25,
                    "alpha": 1
                },
                {
                    "commonName": "VerticalList",
                    "name": "matchlist",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 10,
                    "marginLeft": 0,
                    "x": 0,
                    "y": 0,
                    "displayRange": 4,
                    "rowChangeAction": "act_match_play",
                    "highlightable": true,
                    "row": "MatchDayRow",
                    "rowHeight": 102,
                    "rowWidth": 640,
                    "bindings":
                    [
                        {
                            "binding": "bnd_match_list",
                            "property": "dataProviders"
                        }
                    ]
                },
                {
                   "commonName": "Label",
                   "alignV": "CENTER",
                   "alignH": "CENTER",
                   "fontSize": 20,
                   "fontColor": "$COLOR_WHITE",
                   "fontFace": "$MONTBLANC_TRIAL_BOLD",
                   "text": "NO CONTEST",
                   "bindings":
                    [
                        {
                            "binding": "bnd_match_empty",
                            "property": "visible"
                        }
                    ]
                },
                {
                   "commonName": "Label",
                   "alignV": "CENTER",
                   "alignH": "CENTER",
                   "marginTop": 30,
                   "fontSize": 16,
                   "fontColor": "$COLOR_WHITE",
                   "fontFace": "$FONT_DINPROBOLD",
                   "text": "Please Check Schedule",
                   "bindings":
                    [
                        {
                            "binding": "bnd_match_empty",
                            "property": "visible"
                        }
                    ]
                }
            ]
        }
    ]
}
/*-- Layout Design MVNPROD YouTube --*/