/*-- Modified MVNPROD Youtube Channel --*/
{
    "name": "MainHub",
    "type": "parallel",
    "states":
    [
        {
            "states":
            [
                {
                    "name": "InitHub",
                    "onEnter":
                    [
                        ["showFEUI"],
                        ["enableMainFlowLayerMouseInteraction", ["Widgets", true, false]],
                        ["blockingLoadVVM", ["/flows/mainflow/widgets/extendeduserbio/loading/Loading.vvm"]]
                    ],
                    "onExit":
                    [
                        ["unloadVVM"]
                    ],
                    "transitions":
                    [
                        {
                            "event":   "evt_on_show_fe_ui_complete",
                            "targets": ["Hub"]
                        }
                    ]
                },
                {
                    "onEnter":
                    [
                        ["viewLayer", ["Gamemodes"]],
                        ["stateChange", ["ARENA"]],
                        ["substateChange", ["SUBSTATE_NONE"]],
                        ["updateUserPlateDisplayMode", ["full"]]
                    ],
                    "states":
                    [
                        {
                            "name": "Hub",
                            "onEnter":
                            [
                                ["blockingLoadVVM", ["/Flows/MainFlow/GameModes/MainHub.vvm", {}, { "viewType": "screen" }]],
                                ["stateChange", ["ARENA"]],
                                ["substateChange", ["SUBSTATE_NONE"]],
                                ["updateUserPlateDisplayMode", ["full"]]
                            ],
                            "onExit":
                            [
                                ["unloadVVM", [{}, { "waitForNextView": ".enableScreenTransitions" }]]
                            ],
                            "states":
                            [
                                {
                                    "name": "Fc",
                                    "onEnter":
                                    [
                                        ["setTabMVNPROD", [0]],
                                        ["blockingLoadVVM", ["/flows/mainflow/gamemodes/MainMenu/Fc/PlayHub.vvm"]]
                                    ],
                                    "onExit":
                                    [
                                        ["unloadVVM"]
                                    ],
                                    "transitions":
                                    [
                                        {
                                            "event": "evt_kickoff",
                                            "targets": ["KickOff"]
                                        },
                                        {
                                            "event": "evt_playercareer",
                                            "targets": ["PlayerCareer"]
                                        },
                                        {
                                        "event": "evt_ut",
                                            "targets": ["UT"]
                                        },
                                        {
                                            "event": "evt_Classicmatch",
                                            "targets": ["Classicmatch"]
                                        },
                                        {
                                            "event": "evt_tournaments",
                                            "targets": ["Tournaments"]
                                        },
                                        {
                                            "event": "evt_dailymatch",
                                            "targets": ["DailyMatch"]
                                        },
                                        {
                                            "event": "evt_challenge",
                                            "targets": ["Challenge"]
                                        },
                                        {
                                            "event": "evt_careermode",
                                            "targets": ["CareerMode"]
                                        },
                                        {
                                            "event": "evt_more",
                                            "targets": ["More"]
                                        }
                                    ]
                                },
                                {
                                    "name": "KickOff",
                                    "onEnter":
                                    [
                                        ["setTabMVNPROD", [1]],
                                        ["blockingLoadVVM", ["/flows/mainflow/gamemodes/MainMenu/KickOff/PlayHub.vvm"]]
                                    ],
                                    "onExit":
                                    [
