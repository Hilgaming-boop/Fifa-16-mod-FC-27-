            "y": 400.0,
            "clickAction": "act_prev_index",
            "label": "PREV"
        },
        {
            "commonName": "GenericButton",
            "name": "addBullet",
            "height": 40.0,
            "width": 150.0,
            "x": 200.0,
            "y": 447.0,
            "clickAction": "act_add_bullet",
