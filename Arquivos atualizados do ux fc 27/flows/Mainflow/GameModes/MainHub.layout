{
  "commonName": "Panel",
  "alignH": "CENTER",
  "alignV": "CENTER",
  "bindings": [
    {
      "binding": "BND_SCREEN_HEIGHT",
      "property": "height"
    },
    {
      "binding": "BND_SCREEN_WIDTH",
      "property": "width"
    }
  ],
  "animationScripts": [
    {
      "name": "show",
      "script": [
        {
          "anim": "SLIDE_IN_ALPHA"
        }
      ]
    },
    {
      "name": "hide",
      "script": [
        {
          "anim": "SLIDE_OUT"
        }
      ]
    }
  ],
  "style-definitions":
    {
		"TF_LIVE_TILE_HEADLINE_BOLD_SMALL":
        {
			"fontFace": "$CruyffSans-Expandes",
			"fontSize": 16,
			"fontColor": "$COLOR_LIGHT_GRAY",
            "alpha": 0.5,
			"leading": 0
	    },
		"TF_LIVE_TILE_HEADLINE_SMALL": 
        {
			"fontFace": "$CruyffSans-Expandes",
			"fontSize": 16,
			"fontColor": "$COLOR_WHITE",
			"leading": -4
		},
		"TF_LIVE_TILE_HEADLINE_BOLD_HIGHLIGHTED_SMALL": 
        {
			"fontFace": "$CruyffSans-Expandes",
			"fontSize": 16,
			"fontColor": "$COLOR_WHITE",
			"leading": -4
		},
		"TF_LIVE_TILE_HEADLINE_HIGHLIGHTED_SMALL":
        {
			"fontFace": "$CruyffSans-Expandes",
			"fontSize": 16,
		    "fontColor": "$COLOR_WHITE",
			"leading": -4
        }
    },
