    "animations":
    {
    
		"MOD_SLIDE_IN_RIGHT" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 0, "marginLeft": -50},
                "end" : { "alpha" : 1, "marginLeft": 0},
                "duration" : "$MEDIUM_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "MOD_SLIDE_OUT_RIGHT" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 1, "marginLeft": 0 },
                "end" : { "alpha" : 0, "marginLeft": -100 },
                "duration" : "$MEDIUM_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
		"MOD_SLIDE_IN_ALPHA" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 0, "marginRight": -20},
                "end" : { "alpha" : 1, "marginRight": 0},
                "duration" : "$MEDIUM_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "MOD_SLIDE_OUT" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 1, "marginLeft": 0 },
                "end" : { "alpha" : 0, "marginLeft": -20 },
                "duration" : "$MEDIUM_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
		"SLIDE_IN" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "marginLeft":-50},
                "end" : { "marginLeft":0 },
                "duration" : "$EXTRA_EXTRA_LONG_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
		"SCREEN_TRANSITION_IN" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "x":2000},
                "end" : { "x":0 },
                "duration" : "$SHORT_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "TUTORIAL_TRANSITION_IN" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha":0},
                "end" : { "alpha":1 },
                "duration" : "$LONG_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "TUTORIAL_TRANSITION_OUT" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha":1},
                "end" : { "alpha":0 },
                "duration" : "$LONG_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
		"OVERLAY_TRANSITION_IN" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha":0},
                "end" : { "alpha":1 },
                "duration" : "$SHORT_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
		"SLIDE_IN_ALPHA" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 0},
                "end" : { "alpha" : 1},
                "duration" : "$EXTRA_EXTRA_LONG_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "SLIDE_OUT" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 1, "marginLeft": 0 },
                "end" : { "alpha" : 0, "marginLeft": -50 },
                "duration" : "$LONG_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "SCREEN_TRANSITION_OUT" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 1, "x": 0 },
                "end" : { "alpha" : 0, "x": 50 },
                "duration" : "$SHORT_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "OVERLAY_TRANSITION_OUT" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 1 },
                "end" : { "alpha" : 0 },
                "duration" : "$SHORT_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "SCREEN_SHOW" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 0 },
                "end" : { "alpha" : 1 },
                "duration" : "$FAST_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "SCREEN_HIDE" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 1, "z" : 0 },
                "end" : { "alpha" : 0, "z" : -1000 },
                "duration" : "$FAST_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "SIMPLE_SCREEN_SHOW" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 0 },
                "end" : { "alpha" : 1 },
                "duration" : "$FAST_ANIM_DURATION",
                "easing" : "outBack"
            }
        },
        "SIMPLE_SCREEN_HIDE" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 1 },
                "end" : { "alpha" : 0 },
                "duration" : "$FAST_ANIM_DURATION",
                "easing" : "outBack"
                            }
        },
        "GROUND_TO_TOP_IN" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 0, "marginTop": -50},
                "end" : { "alpha" : 1, "marginTop": 0},
                "duration" : "$LONG_ANIM_DURATION",
                "easing" : "outBack"
                }
        },
        "GROUND_TO_TOP_OUT" :
        {
            "type" : "Absolute",
            "data" :
            {
                "start" : { "alpha" : 1, "y": 0 },
                "end" : { "alpha" : 0, "y": 100 },
                "duration" : "$SHORT_ANIM_DURATION",
                "easing" : "outBack"
            }
        }
    }
}
