{
    "commonName": "Panel",
	"name": "mentalityBar",
	"alignH": "FILL",
	"alignV": "FILL",
    "animationScripts":
    [
        {
            "name": "show",
            "script":
            [
                {
                    "anim": "MOD_SMOOTH_IN_RIGHT"
                }
            ]
        },
        {
            "name": "hide",
            "script":
            [
                {
                    "anim": ""
                }
            ]
        }
    ],    	
    "children":
    [
        {
            "commonName": "Mentality",
            "alignH": "CENTER",
            "alignV": "TOP",
            "marginTop": 0,
            "marginLeft": 0,
            "orientation": "left",
            "bindings":
            [
                {
                    "property": "mentality",
                    "binding":  "bnd_home_mentality"
                },
                {
                    "property": "label",
                    "binding":  "bnd_home_label"
                },
                {
                    "property": "active",
                    "binding":  "bnd_home_active"
                },
                {
                    "property": "visible",
                    "binding":  "bnd_home_mentality_default_visible"
                }
            ]
        },
        {
            "commonName": "Panel",
            "alignV": "TOP",
            "alignH": "RIGHT",
            "width": 250,
            "height": 80,
            "marginRight":255,
            "bindings":[
                {
                    "property": "visible",
                    "binding":  "bnd_home_mentality_new_visible"
                }
            ],
            "children":
            [
                {
                    "commonName": "TabBar",
                    "name": "BagianTab",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "width": 250,
                    "tabs":
                    [
                       {
                           "label": "Defend",
                           "clickAction": "act_defend"
                       },
                       {
                           "label": "Balance",
                           "clickAction": "act_balance"
                       },
                       {
                           "label": "Attack",
                           "clickAction": "act_attack"
                       }
                   ],
                   "bindings":
                   [
                      {
                          "binding": "bnd_home_mentality_index",
                          "property": "selectedIndex"
                      }
                   ]
                }
                
            ]
        }
    ],
    "behaviors":
    [
        {
            "commonName": "PanelLayoutBehavior"
        }
    ]
}