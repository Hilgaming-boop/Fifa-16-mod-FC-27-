						{
							"property": "fontColor",
							"binding":  "bnd_tgl_fontColor"
						},
						{
							"property": "marginLeft",
							"binding":  "bnd_tgl_left"
						},
						{
							"property": "marginTop",
							"binding":  "bnd_tgl_top"
						}
					]
				}
			]
		}    
	]
}                    
