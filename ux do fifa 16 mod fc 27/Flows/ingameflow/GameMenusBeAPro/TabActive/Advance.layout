            "icon": "$SymMatchIcon4"
        },
        {
            "commonName": "Label",
            "alignV": "CENTER",
		    "alignH": "TOP",
		    "marginTop": 275,
            "marginLeft": 145,
            "fontSize": 15,
            "fontColor": "$COLOR_WHITE",
            "fontFace": "$FONT_DINPROBOLD",
            "text": "Select"                    
        },
        {
            "commonName": "Panel",
            "name": "Action",
            "alignV": "FILL",
            "alignH": "FILL",
            "children":
