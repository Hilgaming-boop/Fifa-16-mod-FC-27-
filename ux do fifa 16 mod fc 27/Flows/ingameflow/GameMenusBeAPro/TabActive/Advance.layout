            "alignV": "TOP",
            "alignH": "RIGHT",
            "marginTop": 50,
            "marginRight": 120,
            "width": 470,
            "height": 50,
            "children":
            [
               {
                    "commonName": "Rectangle",
                    "name": "ColorBg",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "color": "0x151515",
                    "cornerRaduis": 10,
                    "alpha": 0.9
                },
                {
                    "commonName": "Label",
                    "name": "time",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 20,
