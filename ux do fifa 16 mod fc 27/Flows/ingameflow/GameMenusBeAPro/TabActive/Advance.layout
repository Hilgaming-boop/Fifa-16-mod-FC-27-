{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		    "script" : [ { "anim" : "OVERLAY_TRANSITION_IN" } ]
	    },
	    {
			"name" : "hide",
		    "script" : [ { "anim" : "OVERLAY_TRANSITION_OUT" } ]
	    }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 1,
            "type": "$BackgroundIngameflow"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.8,
            "type": "$BG_Highlight"
        },
        {
            "commonName": "Asset",
            "alignV": "TOP",
            "alignH": "LEFT",
            "marginTop": 15,
            "marginLeft": 115,
            "width": 70,
            "height": 70,
            "type": "$Icons_PC"
        },
        {
            "commonName": "Label",
            "alignV": "TOP",
            "alignH": "LEFT",
            "marginTop": 45,
            "marginLeft": 195,
            "fontSize": 17,
            "fontColor": "$COLOR_WHITE",
            "fontFace": "$CruyffSansMedium",
            "text": "Player Career"    
        },
        {  
            "commonName": "SimpleButton",
            "alignH": "LEFT",
            "alignV": "CENTER",
            "marginTop": -132,
            "marginLeft": 120,           
            "clickAction": "act_menu_restart",           
            "bindings":
            [
              {
                  "binding": "bnd_label_restart_off",
                  "property": "label"
              }
            ],
            "textStyles":
            [
                "TF_LIVE_TILE_HEADLINE_SMALL"
            ]          
        },
        {    
            "commonName": "SimpleButton",
            "alignH": "LEFT",
            "alignV": "CENTER",
            "marginTop": -88,
            "marginLeft": 108,          
            "clickAction": "act_menu_facts",           
            "bindings":
            [
              {
                  "binding": "bnd_label_facts_off",
                  "property": "label"
              }
            ],
            "textStyles":
            [
                "TF_LIVE_TILE_HEADLINE_SMALL"
            ]          
        },
        {   
            "commonName": "SimpleButton",
            "alignH": "LEFT",
            "alignV": "CENTER",
            "marginTop": -42,
            "marginLeft": 105,  
            "clickAction": "act_menu_highlight",           
            "bindings":
            [
              {
                  "binding": "bnd_label_highlight_off",
