            "alignV": "CENTER",
            "marginTop": -132,
            "marginLeft": 115,      
            "fontSize": 23,
            "fontFace": "$CruyffSans-Extended-Heavy",
            "fontColor": "0xffffff",
            "forceCaps": true,                 
            "bindings":
            [
              {
                 "binding": "bnd_label_restart_on",
                 "property": "text"
              }
            ]
        },
        {    
