{
    "commonName": "Panel",
    "name": "rootContainer",
    "alignV": "CENTER",
    "alignH": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        },
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		    "script" : [ { "anim" : "OVERLAY_TRANSITION_IN" } ]
	    },
	    {
			"name" : "hide",
		    "script" : [ { "anim" : "OVERLAY_TRANSITION_OUT" } ]
	    }
    ],
        "style-definitions":
    {
		"TF_LIVE_TILE_HEADLINE_BOLD_SMALL":
        {
			"fontFace": "$CruyffSans-Extended-Heavy",
            "forceCaps": true,
			"fontSize": 15,
			"fontColor": "0xF7FF00",
			"leading": 0
	    },
		"TF_LIVE_TILE_HEADLINE_SMALL": 
        {
		"fontFace": "$CruyffSans-Extended-Heavy",
            "forceCaps": true,
			"fontSize": 15,
			"fontColor": "0xFF767676",
			"leading": 0
        },
        "TF_CONTEXT_MENU_ROW":
        {
			"fontFace": "$CruyffSans-Extended-Heavy",
            "forceCaps": true,
			"fontSize": 25,
			"fontColor": "0xFFFFFF",
			"leading": 0
		},
		"TF_LIVE_TILE_HEADLINE_BOLD_HIGHLIGHTED_SMALL": 
        {
			"fontFace": "$CruyffSansExpanded",
			"fontSize": 20,
			"fontColor": "$COLOR_WHITE",
			"leading": -4
		},
		"TF_LIVE_TILE_HEADLINE_HIGHLIGHTED_SMALL":
        {
			"fontFace": "$CruyffSansExpanded",
			"fontSize": 20,
		    "fontColor": "$COLOR_MEDIUM_GRAY",
			"leading": 0
        }
    },
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 1,
            "type": "$BackgroundIngameflow"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.8,
            "type": "$BG_Highlight"
        },
        {
            "commonName": "Asset",
            "alignV": "TOP",
            "alignH": "LEFT",
            "marginTop": 15,
            "marginLeft": 115,
            "width": 70,
            "height": 70,
            "type": "$Icons_PC"
        },
        {
            "commonName": "Label",
            "alignV": "TOP",
            "alignH": "LEFT",
            "marginTop": 45,
            "marginLeft": 195,
            "fontSize": 17,
            "fontColor": "$COLOR_WHITE",
            "fontFace": "$CruyffSansMedium",
            "text": "Player Career"    
        },
        {   
            "commonName": "SimpleButton",
            "alignH": "LEFT",
            "alignV": "CENTER",
            "marginTop": -177,
            "marginLeft": 86,               
            "clickAction": "act_menu_advance",           
            "bindings":
            [
              {
                  "binding": "bnd_label_advance_off",
                  "property": "label"
              }
            ],
            "textStyles":
            [
                "TF_LIVE_TILE_HEADLINE_SMALL"
            ]          
        },
        {    
            "commonName": "SimpleButton",
            "alignH": "LEFT",
            "alignV": "CENTER",
            "marginTop": -132,
            "marginLeft": 120,           
            "clickAction": "act_menu_restart",           
            "bindings":
            [
              {
                  "binding": "bnd_label_restart_off",
