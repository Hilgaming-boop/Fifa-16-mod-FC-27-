            "alignV": "CENTER",
            "marginTop": -88,
            "marginLeft": 115,        
            "fontSize": 23,
            "fontFace": "$CruyffSans-Extended-Heavy",
            "fontColor": "0xffffff",
            "forceCaps": true,                 
            "bindings":
            [
              {
                 "binding": "bnd_label_facts_on",
                 "property": "text"
              }
            ]    
        },
        {   
            "commonName": "SimpleButton",
            "alignH": "LEFT",
            "alignV": "CENTER",
            "marginTop": -42,
            "marginLeft": 105,  
            "clickAction": "act_menu_highlight",           
            "bindings":
            [
              {
                  "binding": "bnd_label_highlight_off",
                  "property": "label"
              }
            ],
            "textStyles":
            [
                "TF_LIVE_TILE_HEADLINE_SMALL"
            ]          
        },
        {
            "commonName": "Label",
            "alignH": "LEFT",
            "alignV": "CENTER",
            "marginTop": -42,
            "marginLeft": 113,  
            "fontSize": 23,
            "fontFace": "$CruyffSans-Extended-Heavy",
            "fontColor": "0xffffff",
            "forceCaps": true,                 
            "bindings":
            [
              {
                 "binding": "bnd_label_highlight_on",
                 "property": "text"
              }
            ]
        },
        {
            "commonName": "GenericButton",
            "alignV": "CENTER",
		    "alignH": "TOP",
		    "marginTop": 275,
            "marginLeft": 35,
            "width": 150,                  
            "height": 60.0,
            "icon": "$SymMatchIcon4"
        },
        {
            "commonName": "Label",
            "alignV": "CENTER",
		    "alignH": "TOP",
		    "marginTop": 275,
            "marginLeft": 145,
            "fontSize": 15,
            "fontColor": "$COLOR_WHITE",
            "fontFace": "$FONT_DINPROBOLD",
            "text": "Select"                    
        },
        {           
            "commonName": "Panel",
            "name": "TableScore",
            "alignV": "TOP",
            "alignH": "RIGHT",
            "marginTop": 50,
            "marginRight": 120,
            "width": 470,
            "height": 50,
            "children":
            [
               {
                    "commonName": "Rectangle",
                    "name": "ColorBg",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "color": "0x151515",
                    "cornerRaduis": 10,
                    "alpha": 0.9
                },
                {
                    "commonName": "Label",
                    "name": "time",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 20,
                    "fontSize": 17,
                    "fontColor": "$COLOR_WHITE",
                    "fontFace": "$FONT_DINPROBOLD",
                    "bold": true,
                    "bindings":
                    [
                        {
                           "binding": "bnd_time",
                           "property": "text"
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "Team",
                    "alignV": "CENTER",
                    "alignH": "RIGHT",
                    "marginTop": 0,
                    "marginRight": 0,
                    "width": 400,
                    "height": 50,
                    "children":
                    [
                        {
                            "commonName": "Label",
                            "name": "Score",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginBottom": 0,
                            "fontSize": 19,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_DINPROBOLD",
                            "bindings":
                            [
                                {
                                    "binding": "bnd_result",
                                    "property": "text"
                                }
                            ]
                       },
                       {
                            "commonName": "Image",
                            "name": "LogoTeamHome",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": -50,
                            "scaleX": 0.13,
                            "scaleY": 0.13,
                            "bindings":
                            [
                               {
                                  "binding": "bnd_home_team_crest",
                                  "property": "image"
                               }
                            ]
                        },
                        {
                            "commonName": "Image",
                            "name": "LogoTeamAway",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": 50,
                            "scaleX": 0.13,
                            "scaleY": 0.13,
                            "bindings":
                            [
                               {
                                  "binding": "bnd_away_team_crest",
                                  "property": "image"
                               }
                            ]
                       },
                       {
                            "commonName": "Label",
                            "name": "NameTeamHome",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginBottom": 0,
                            "marginLeft": -135,
                            "fontSize": 15,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_DINPROBOLD",
                            "autoScroll":true,
                            "width": 120,
                            "bindings":
                            [
                               {
                                  "binding": "bnd_home_team_name",
                                  "property": "text"
                               }
                            ]
                        },
                        {
                            "commonName": "Label",
                            "name": "NameTeamAway",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginBottom": 0,
                            "marginLeft": 135,
                            "fontSize": 15,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_DINPROBOLD",
                            "autoScroll":true,
                            "width": 120,
                            "bindings":
                            [
                               {
                                  "binding": "bnd_away_team_name",
                                  "property": "text"
                               }
                            ]
