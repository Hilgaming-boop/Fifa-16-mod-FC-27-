{
    "commonName": "Panel",
    "name": "rootContainer",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        },
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        }
    ],
    "style-definitions":
    {
    "TF_LIVE_TILE_HEADLINE_BOLD_SMALL":
        {
			"fontFace": "$CruyffSansExpanded",
			"fontSize": 16,
			"alpha": 0.9,
			"fontColor": "0x808080",
			"leading": 0
	    },
		"TF_LIVE_TILE_HEADLINE_BOLD_HIGHLIGHTED_SMALL": 
        {
			"fontFace": "$CruyffSansExpanded",
			"fontSize": 0,
			"fontColor": "$COLOR_WHITE",
			"leading": 0
		}
    },        
    "children":
    [
         {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
                {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 130,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$",
                    "clickAction": "act_forfeit_match"
                }
            ]
        },
        {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "CENTER",
            "alignH": "FILL",
            "marginLeft": 85,
            "marginTop": 20,
            "height": 450,
            "children":
            [
                {
                    "commonName": "Asset",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 318,
                    "marginLeft": -20,
                    "height": 90,
                    "width": 194,
                    "alpha": 1,
                    "path": "views/backgrounds/Green_Effect.swf"
                },
                {
                    "commonName": "Label",
                    "name": "Live",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 350,
                    "marginLeft": 24.7,
                    "fontSize": 16,
                    "fontColor": "$COLOR_WHITE",
                    "fontFace": "$CruyffSansExpandes",
                    "text": "END MATCH"
                }
            ]
         }
     ]
}

