            "height": 450,
            "children":
            [    
                {
                    "commonName": "Panel",
                    "name": "BtPanel",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": -15,
                    "marginLeft": 50,
                    "width": 300,
                    "height": 15,
                    "alpha": 0,
                    "animationScripts":
                    [
                        {
                            "name": "animateBt",
                            "script":
                            [
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 0,
                                            "marginTop": 0
                                        },
                                        "duration": 1
                                    }
                                },
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 1,
                                            "marginLeft": 50
                                        },
                                        "duration": 1000,
                                        "easing": "OutBack"
                                    }
                                }
                            ]
                        }
                    ],
                    "children":
                    [                  
        {

            "commonName": "Image",
            "alignV": "TOP",
            "alignH": "LEFT",
            "bindings":
            [
                {
                    "property": "image",
                    "binding":  "bnd_icon"
                },
                {
                   "property": "marginLeft",
                   "binding":  "bnd_icon_left"
                },
                {
                    "property": "marginTop",
                    "binding":  "bnd_icon_top"
               },
               {
                    "property": "width",
                    "binding":  "bnd_icon_width"
               },
               {
                    "property": "height",
                    "binding":  "bnd_icon_height"
                }
            ]
                        }
                    ]
                }
            ],
            "behaviors":
