{
    "commonName": "Panel",
    "name": "rootContainer",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        },
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        }
    ],
    "animationScripts":
    [
        {
		         	"name" : "show",
		         	"script" :
		         	[
			             	{
					              "anim" : "SCREEN_SHOW"
			             	}
		         	]
		     },
		     {
		         	"name" : "hide",
		         	"script" :
		         	[
			             	{
					              "anim" : "SIMPLE_SCREEN_HIDE"
			             	}
		         	]
	       	}
    ],
