                    "marginTop": 80,
                    "marginLeft": 190,
                    "fontFace": "$FONT_BOLD",
                    "fontSize": 20,
                    "fontColor": "$COLOR_WHITE",
                    "text": "Rating:"
                 },
                 {
                    "commonName": "VerticalList",
                    "name": "teamlist",
                    "alignV": "TOP",
                    "alignH": "CENTER",
                    "marginTop": 110,
                    "marginLeft": -260,
                    "x": 0,
                    "y": 0,
                    "displayRange": 6,
                    "rowChangeAction": "act_team_select",
