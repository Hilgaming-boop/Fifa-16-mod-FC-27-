            "alignH": "LEFT",
            "icon": "$SimMatchIcon3",
            "actionName": "act_back",
            "label": "Back"
        }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$_Background_2"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.3,
            "type": "$Bg_Smoke"
        },
        {
            "commonName": "Panel",
            "name": "BagianMenu",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": -25,
            "marginLeft": 0,
            "width": 750,
            "height": 485,
            "children":
            [
                {
                    "commonName": "Rectangle",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "color": "",
                    "alpha": 0.5
                },
                {
                    "commonName": "Rectangle",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "height": 40,
                    "color": ""
                },
                {
                   "commonName": "Label",
                   "alignV": "TOP",
                   "alignH": "CENTER",
                   "marginTop": 5,
                   "marginLeft": 0,
                   "fontSize": 30,
                   "fontFace": "$FONT_CRUYFFSANSMEDIUM",
			       "fontColor": "0xffffff",
			       "text": "Challenge Season"			  
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
                    "alignH": "CENTER",
                    "marginTop": 80,
                    "marginLeft": -220,
                    "fontFace": "$FONT_BOLD",
                    "fontSize": 20,
                    "fontColor": "$COLOR_WHITE",
                    "text": "Teams:"
                 },
                 {
                    "commonName": "Label",
                    "alignV": "TOP",
