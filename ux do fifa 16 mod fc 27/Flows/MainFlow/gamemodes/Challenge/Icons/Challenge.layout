            "label": "Back"
        },
        {
            "commonName": "TickerNavPublisher",
            "alignH": "LEFT",
            "icon": "$SimMatchIcon2",
            "actionName": "act_restart",
            "label": "Forfeit"
        },
        {
            "commonName": "TickerNavPublisher",
            "alignH": "LEFT",
            "icon": "$SimMatchIcon",
            "actionName": "act_squad",
            "label": "Squad"
        }
    ],
    "children":
    [ 
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Rival"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.3,
            "type": "$Bg_Smoke"
        },
        {
            "commonName": "Panel",
            "name": "BagianMenu",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": -25,
            "marginLeft": 0,
            "width": 750,
            "height": 485,
            "children":
            [
                {
                    "commonName": "Rectangle",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "color": "0x202020",
                    "alpha": 0.9
                },
                {
                    "commonName": "Rectangle",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "height": 40,
                    "color": "0x000000"
                },
                {
                   "commonName": "Label",
                   "alignV": "TOP",
                   "alignH": "CENTER",
                   "marginTop": 5,
                   "marginLeft": 0,
                   "fontSize": 30,
                   "fontFace": "$FONT_CRUYFFSANSMEDIUM",
			       "fontColor": "$COLOR_WHITE",
                   "bindings":[
                    {
                        "binding":"bnd_match_label",
                        "property":"text"
                     }
                   ]
                },
                {
                    "commonName": "VerticalList",
                    "name": "matchlist",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 50,
                    "marginLeft": 20,
                    "x": 0,
                    "y": 0,
                    "displayRange": 4,
                    "rowChangeAction": "act_advance",
                    "highlightable": true,
                    "row": "ChallengeRow",
                    "rowHeight": 107.5,
                    "rowWidth": 745.0,
                    "bindings":
                    [
                        {
                            "binding": "bnd_match_list",
                            "property": "dataProviders"
                        }
                    ]
                }
            ]
        }
