{
  "commonName": "Panel",
  "alignH": "CENTER",
  "alignV": "CENTER",
  "bindings": [
    {
      "binding": "BND_SCREEN_HEIGHT",
      "property": "height"
    },
    {
      "binding": "BND_SCREEN_WIDTH",
      "property": "width"
    }
  ],
    "animationScripts":
    [
        {
            "name": "show",
            "script":
            [
                {
                    "anim": "MOD_SMOOTH_IN_RIGHT"
                }
            ]
        },
        {
            "name": "hide",
            "script":
            [
                {
                    "anim": ""
                }
            ]
        }
    ],    
  "children": [
            {
              "commonName": "Image",
              "name": "devCrestImage",
              "alignH": "FILL",
              "alignV": "FILL",
              "bindings": [
                {
                  "binding": "bnd_dev_crest",
                  "property": "image"
                }
              ]
            },
            {
              "commonName": "Label",
              "alignV": "BOTTOM",
              "alignH": "CENTER",
              "marginBottom": 50,
              "marginLeft": 0,
              "fontSize": 12,
              "fontColor": "$COLOR_WHITE",
              "fontFace": "$CruyffSans-Regular",
              "text": ""
            },
         {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "TOP",
            "alignH": "FILL",
            "marginRight": 0,
            "marginTop": -10,
            "height": 450,
            "children":
            [    
                {
                    "commonName": "Panel",
                    "name": "Panel",
                    "alignV": "TOP",
                    "alignH": "RIGHT",
                    "marginTop": -30,
                    "marginRight": 0,
                    "width": 300,
                    "height": 15,
                    "alpha": 0,
                    "animationScripts":
                    [
                        {
                            "name": "animate",
                            "script":
                            [
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 0,
                                            "marginTop": 0
                                        },
                                        "duration": 1
                                    }
                                },
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 1,
                                            "marginTop": 20
                                        },
                                        "duration": 1000,
                                        "easing": "OutBack"
                                    }
                                }
                            ]
                        }
                    ],
                    "children":
                    [                                       
            {
            "commonName": "Asset",
            "alignV": "TOP",
            "alignH": "RIGHT",
            "marginTop": 30,
            "marginRight": 50,
            "height": 30,
            "width": 140,
            "type": "$Icon_FC25_In"
                       }
                    ]
                }
            ],
            "behaviors":
            [
                {
                    "commonName": "TriggerScriptBehavior",
                    "name": "trigger_animate",
                    "script": "animate",
                    "target": "Panel"
                },
                {
                    "commonName": "TriggerOnTrue",
                    "name": "trigger_on_true",
                    "target": "trigger_animate",
                    "bindings":
                    [
                        {
                            "binding": "bnd_animate_count1",
                            "property": "value"
                        }
                    ]
                }
             ]
		 }, 
         {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "CENTER",
            "alignH": "FILL",
