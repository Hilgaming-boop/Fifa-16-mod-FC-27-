/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Rival"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.2,
            "type": "$Bg_Smoke"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.6,
            "type": "$Bg_InGame"
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "label": "",
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
                {
                    "commonName": "Asset",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": -10,
                    "marginLeft": -140,
                    "height": 200,
                    "width": 205,
                    "path": "views/backgrounds/Triangles.swf"
                },
                {
                    "commonName": "Asset",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 10,
                    "marginLeft": 100,
                    "height": 35,
                    "width": 100,
                    "type": "$Icon_FC25"
                },
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 15,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 230,
                            "fontSize": 27,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_BOLD",
                            "alpha": 0.5,
                            "text": "|"
                        },
                        {
                            "commonName": "LiveTile",
                            "name": "ClassicMatch",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginBottom": 7,
                            "marginLeft": 260,
                            "width": 300,
                            "height": 30,
                            "clickAction": "act_about",
                            "headline": ["About"]
                        },
                        {
                            "commonName": "LiveTile",
                            "name": "ClassicMatch",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginBottom": 7,
                            "marginLeft": 345,
                            "width": 300,
                            "height": 30,
                            "clickAction": "act_web",
                            "headline": ["Website"]
                        },
                        {
                            "commonName": "LiveTile",
                            "name": "ClassicMatch",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginBottom": 7,
                            "marginLeft": 450,
                            "width": 300,
                            "height": 30,
                            "clickAction": "act_youtube",
                            "headline": ["YouTube"]
                        }
                    ]
                }
            ]
        }
    ]
}
/*-- Layout Design MVNPROD YouTube --*/