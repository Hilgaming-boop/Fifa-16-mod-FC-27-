{
    "name": "About",
    "initial":
    {
        "targets": ["RedirectAbout"]
    },
    "states":
    [
        {
            "name": "RedirectAbout",
            "onEnter":
            [
                  ["blockingLoadVVM", ["AboutHub.vvm"]]
            ],
            "onExit":
            [
                ["unloadVVM"]
            ],
            "transitions":
            [
                {
                    "event": "evt_back",
                    "targets": ["out_exit_gamemode"]
                }
            ]
        }
    ]
}