/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Splash"
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "label": "",
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
         {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "TOP",
            "alignH": "FILL",
            "marginLeft": 0,
            "marginTop": -30,
            "height": 450,
            "children":
            [    
                {
                    "commonName": "Panel",
                    "name": "Panel",
                    "alignV": "TOP",
                    "alignH": "CENTER",
                    "marginTop": -30,
                    "marginLeft": 0,
                    "width": 300,
                    "height": 15,
                    "alpha": 0,
                    "animationScripts":
                    [
                        {
                            "name": "animate",
                            "script":
                            [
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 0,
                                            "marginTop": 0
                                        },
                                        "duration": 1
                                    }
                                },
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 1,
                                            "marginTop": 20
                                        },
                                        "duration": 1000,
                                        "easing": "OutBack"
                                    }
                                }
                            ]
                        }
                    ],
                    "children":
                    [                                                
                {
                    "commonName": "Asset",
                    "alignV": "TOP",
                    "alignH": "CENTER",
                    "marginTop": 120,
                    "marginLeft": 0,
                    "height": 35,
                    "width": 150,
                    "type": "$Icon_FC25_In"
                       }
                    ]
                }
            ],
            "behaviors":
            [
                {
                    "commonName": "TriggerScriptBehavior",
                    "name": "trigger_animate",
                    "script": "animate",
                    "target": "Panel"
                },
                {
                    "commonName": "TriggerOnTrue",
                    "name": "trigger_on_true",
                    "target": "trigger_animate",
                    "bindings":
                    [
                        {
                            "binding": "bnd_animate_count1",
                            "property": "value"
                        }
                    ]
                }
             ]
		 }, 
         {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "TOP",
            "alignH": "FILL",
            "marginLeft": -60,
            "marginTop": 25,
            "height": 450,
            "children":
            [    
                {
                    "commonName": "Panel",
                    "name": "BtPanel",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginTop": 25,
                    "marginLeft": -60,
                    "width": 300,
                    "height": 15,
                    "alpha": 0,
                    "animationScripts":
                    [
                        {
                            "name": "animateBt",
                            "script":
                            [
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 0,
                                            "marginTop": 30
                                        },
                                        "duration": 1
                                    }
                                },
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 1,
                                            "marginLeft": 30
                                        },
                                        "duration": 1000,
                                        "easing": "OutBack"
                                    }
                                }
                            ]
                        }
                    ],
                    "children":
                    [                          
                {
                    "commonName": "Label",
                    "alignH": "CENTER",
                    "alignV": "CENTER",
                    "marginBottom": 60,
                    "marginLeft": 0,
                    "fontSize": 75,
                    "fontFace": "$MONTBLANC_TRIAL_EXTRABOLD",
                    "fontColor":"$COLOR_WHITE",
                    "text": "THE CLUB"
                        }
                    ]
                }
            ],
            "behaviors":
            [
                {
                    "commonName": "TriggerScriptBehavior",
                    "name": "trigger_animate_bt",
                    "script": "animateBt",
                    "target": "BtPanel"
                },
                {
                    "commonName": "TriggerOnTrue",
                    "name": "trigger_on_true_bt",
                    "target": "trigger_animate_bt",
                    "bindings":
                    [
                        {
                            "binding": "bnd_animate_count1",
                            "property": "value"
                        }
                    ]
                }
             ]
		 }, 
         {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "TOP",
            "alignH": "FILL",
            "marginRight": -60,
            "marginTop": 0,
            "height": 450,
            "children":
            [    
                {
                    "commonName": "Panel",
                    "name": "BtPanel",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginTop": 0,
                    "marginRight": -60,
                    "width": 300,
                    "height": 15,
                    "alpha": 0,
                    "animationScripts":
                    [
                        {
                            "name": "animateBt",
                            "script":
                            [
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 0,
                                            "marginTop": 65
                                        },
                                        "duration": 1
                                    }
                                },
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 1,
                                            "marginRight": 30
                                        },
                                        "duration": 1000,
                                        "easing": "OutBack"
                                    }
                                }
                            ]
                        }
                    ],
                    "children":
                    [                     		
                {
                    "commonName": "Label",
                    "alignH": "CENTER",
                    "alignV": "CENTER",
                    "marginBottom": -20,
                    "marginLeft": 0,
                    "fontSize": 75,
                    "fontFace": "$MONTBLANC_TRIAL_EXTRABOLD",
                    "fontColor":"$COLOR_WHITE",
                    "text": "IS YOURS"
                        }
                    ]
                }
            ],
            "behaviors":
            [
                {
                    "commonName": "TriggerScriptBehavior",
                    "name": "trigger_animate_bt",
                    "script": "animateBt",
                    "target": "BtPanel"
                },
                {
                    "commonName": "TriggerOnTrue",
                    "name": "trigger_on_true_bt",
                    "target": "trigger_animate_bt",
                    "bindings":
                    [
                        {
                            "binding": "bnd_animate_count1",
                            "property": "value"
                        }
                    ]
                }
             ]
		 }, 
                {
                    "commonName": "Label",
                    "alignH": "CENTER",
                    "alignV": "BOTTOM",
                    "marginBottom": 120,
                    "marginLeft": 0,
                    "fontSize": 10,
                    "fontFace": "$FONT_DINPROBOLD",
                    "fontColor":"0xffffff",
                    "text": "©2026 Mod Create inisial A",
                    "alpha": 0.3
                }
            ]
        },
        {
            "commonName": "Panel",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": 280,
            "width": 700,
            "height": 430,
            "alpha": 0.5,
            "children":
            [
                {
                   "commonName": "Label",
                   "alignV": "TOP",
                   "alignH": "CENTER",
                   "marginTop": 20,
                   "fontSize": 15,
                   "fontFace": "$FONT_DINPROBOLD",
                   "fontColor": "$COLOR_LIGHT_GRAY",
                   "autoTextShadow": true,
                   "text": "FUT16, Which was modified to become EAFC26"
                },
                {
                   "commonName": "Label",
                   "alignV": "TOP",
                   "alignH": "CENTER",
                   "marginTop": 40,
                   "fontSize": 15,
                   "fontFace": "$FONT_DINPROBOLD",
                   "fontColor": "$COLOR_LIGHT_GRAY",
                   "autoTextShadow": true,
                   "text": "This is a football simulation video game for mobile"
                },
                {
                   "commonName": "Label",
                   "alignV": "TOP",
                   "alignH": "CENTER",
                   "marginTop": 60,
                   "fontSize": 15,
                   "fontFace": "$FONT_DINPROBOLD",
                   "fontColor": "$COLOR_LIGHT_GRAY",
                   "autoTextShadow": true,
                   "text": "Developed Electronic Arts under the EA Sports label."
                }
            ]
        },
        {
            "commonName": "Panel",
            "name": "Loading",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "height": 580,
            "children":
            [
                {
                    "commonName": "Asset",
                    "alignV": "BOTTOM",
                    "alignH": "CENTER",
                    "marginLeft": 3,
                    "height": 50,
                    "width": 50,
                    "alpha": 1,
                    "path": "views/loadingindicator/loadingIcon.swf"
                }
            ]
        }
    ]
}
/*-- Layout Design MVNPROD YouTube --*/
