            "label": ""
        }
    ],
    "children":
    [    
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": 10,
            "width": 900,
            "height": 450,
            "children":
            [
                {
                    "commonName": "Rectangle",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "alpha": 1,
                    "cornerRaduis": 20,
                    "bindings":
                    [
			            {
				            "binding": "bnd_color_tourid",
					    	"property": "fillColor"
						}
					]
				},
                {
                    "commonName": "Rectangle",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "height": 54,
                    "alpha": 1,
                    "cornerRaduis": 10,
                    "bindings":
                    [
			            {
				            "binding": "bnd_color_tourid2",
					    	"property": "fillColor"
						}
					]
				},
                {
                    "commonName": "Image",
                    "name": "CupLogo",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 7,
                    "marginLeft": 27,
                    "width": 45,
                    "height": 45,
                    "bindings":
                    [
                        {
                            "binding": "bnd_logo",
                            "property": "image"
                        }
                    ]
                },
                {
                    "commonName": "Label",
                    "alignV": "TOP",
