                    "marginTop": 18,
                    "marginLeft": 85,
                    "fontSize": 18,
                    "fontFace": "$FONT_CRUYFFSANSBOLD",
                    "fontColor": "0xFFFFFF",
                    "forceCaps": false,
                    "alpha": 1,
                    "bindings":
                    [
                        {
                            "binding": "bnd_tour_label",
                            "property": "text"
                        }
