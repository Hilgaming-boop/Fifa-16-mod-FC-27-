                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 13,
                    "marginLeft": 275,
                    "forceCaps": false,
                    "fontSize": 18,
                    "fontFace": "$FONT_CRUYFFSANSREGULAR",
                    "fontColor": "$COLOR_WHITE",
                    "text": ""
                }
            ]
        },
        {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "TOP",
            "alignH": "FILL",
            "marginTop": 40,
            "height": 30,
            "children":
            [
                {
                    "commonName": "Label",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 93,
                    "fontSize": 38,
                    "fontFace": "$FONT_EAFCGAMEMODES",
	                "fontColor": "0xFFFFFF",
                    "bindings":
                    [
                        {
                            "binding": "bnd_dynamic_label",
                            "property": "text"
                        }
		            ]
                },
                {
                    "commonName": "Label",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "forceCaps": false,
                    "marginLeft": 155,
                    "fontSize": 20,
                    "fontFace": "$FONT_CRUYFFSANSBOLD",
                    "fontColor": "0xFFFFFF",
                    "text": "Office"
                },
                {
                    "commonName": "Rectangle",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 247,
                    "width": 2,
                    "height": 23,
                    "color": "0xA8A8A8",
                    "alpha": 1   
                }
            ]
        },
            {
                "commonName": "Panel",
                "alignV": "TOP",
                "alignH": "LEFT",
                "marginLeft": 280,
                "marginTop": 45,                        
                "bindings": [
                    {
                        "binding": "bnd_visible_show",
                        "property": "visible"
                    }
                ],
                "children": [
                    {
                        "commonName": "Label",
                        "fontSize": 20,
                        "fontFace": "$FONT_CRUYFFSANSBOLD",
                        "fontColor": "0xFFFFFF",
                        "text": "Standings"
                    }
                ]
            },        
            {
              "commonName": "TabBar",
              "alignV": "TOP",
              "alignH": "LEFT",
              "marginTop": 35,
              "marginLeft": 260,
              "textAlign": "LEFT",
              "width": 780,
              "height": 20,
              "tabs": [
                {
                  "label": "Standings",
                  "clickAction": "act_tab1"
                },
                {
                  "label": "Round Of 32",
                  "clickAction": "act_tab2"
                },
                {
                  "label": "Round Of 16",
                  "clickAction": "act_tab3"
                },
                {
                  "label": "Quarter Final",
                  "clickAction": "act_tab4"
                },
                {
                  "label": "Semi-Finals",
                  "clickAction": "act_tab5"
                },
                {
                  "label": "Final  ",
                  "clickAction": "act_tab6"
                }                
				],
				"bindings": [
				{
					"binding": "bnd_tab_index",
					"property": "selectedIndex"
				},
				{
					"binding": "bnd_visible_hide",
					"property": "visible"
				}				
				]
				},                                        
        {
            "commonName": "Panel",
            "name": "Info",
            "alignV": "TOP",
            "alignH": "RIGHT",
