{
    "commonName": "Panel",
    "name": "rootContainer",
	"alignV": "CENTER",
    "alignH": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        },
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        }
    ],
    "animationScripts":
    [
        {
            "name": "show",
            "script":
            [
                {
                    "anim": "FC26_MENU_SHOW"
                }
            ]
        },
        {
            "name": "hide",
            "script":
            [
                {
                    "anim": "FC26_MENU_HIDE"
                }
            ]
        }
    ],
    "style-definitions": {
    "TF_TABS_IDLE": {
      "alignH": "LEFT",
      "fontFace": "$Title",
      "fontSize": 22,
      "fontColor": "$COLOR_LIGHT_GRAY",
      "alpha": 0.5,
      "width": 200
    },
    "TF_TABS_HIGHLIGHT": {
      "alignH": "LEFT",
      "fontFace": "$Title",
      "fontSize": 22,
      "fontColor": "$COLOR_WHITE"
    },
    "TF_TABS_SELECTED": {
      "alignH": "LEFT",
      "fontFace": "$Title",
      "fontSize": 22,
      "fontColor": "$COLOR_WHITE",
      "alpha": 1
    }
  },    
    "behaviors":
    [
        {
            "commonName": "TickerNavPublisher",
            "alignH": "LEFT",
            "icon": "",
            "actionName": "act_back",
            "label": ""
        }
    ],
    "children":
    [    
        {  
            "commonName": "Image",
            "alignV": "FILL",
            "alignH": "FILL",
            "bindings":
            [
                {
                    "binding": "bnd_bg_tour",
                    "property": "image"
                }
			]
        },
        {
            "commonName": "Panel",
            "name": "Back",
            "alignV": "FILL",
            "alignH": "FILL",
            "children":
            [
                {
                    "commonName": "GenericButton",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": -2,
                    "marginLeft": 50,
                    "height": 50,
                    "width": 50,
                    "label": "",
                    "icon": "$SimMatchIcon3",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 13,
                    "marginLeft": 110,
                    "forceCaps": false,
                    "fontSize": 18,
                    "fontFace": "$FONT_CRUYFFSANSREGULAR",
                    "fontColor": "$COLOR_WHITE",
                    "text": "Back"
                }
            ]
        },
        {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "TOP",
            "alignH": "FILL",
            "marginTop": 40,
            "height": 30,
            "children":
            [
                {
                    "commonName": "Label",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 93,
                    "fontSize": 38,
                    "fontFace": "$FONT_EAFCGAMEMODES",
	                "fontColor": "0xFFFFFF",
                    "bindings":
                    [
                        {
                            "binding": "bnd_dynamic_label",
                            "property": "text"
                        }
		            ]
                },
                {
                    "commonName": "Label",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "forceCaps": false,
                    "marginLeft": 155,
                    "fontSize": 20,
                    "fontFace": "$FONT_CRUYFFSANSBOLD",
                    "fontColor": "0xFFFFFF",
                    "text": "Office"
                },
                {
                    "commonName": "Label",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "forceCaps": false,
                    "marginLeft": 210,
                    "fontSize": 20,
                    "alpha": 0.5,
                    "fontFace": "$Default",
                    "fontColor": "0xFFFFFF",
                    "text": "          |"
                }                                        
            ]
        },
            {
              "commonName": "TabBar",
              "alignV": "TOP",
              "alignH": "LEFT",
              "marginTop": 35,
              "marginLeft": 280,
              "textAlign": "LEFT",
              "width": 400,
              "height": 20,
              "tabs": [
                {
                  "label": "Top Scorers",
                  "clickAction": "act_goalscorers"
                },
                {
                  "label": "Yellow Card",
                  "clickAction": "act_yellowcard"
                },
                {
                  "label": "Red Card",
                  "clickAction": "act_redcard"
                }
				],
				"bindings": [
				{
					"binding": "bnd_tab_index",
					"property": "selectedIndex"
				}
				]
				}             
                    ]
                }
            ]
        }
    ]
}