{
  "commonName": "Panel",
  "name": "rootContainer",
  "alignV": "CENTER",
  "alignH": "CENTER",
  "bindings": [
    { "binding": "BND_SCREEN_WIDTH", "property": "width" },
    { "binding": "BND_SCREEN_HEIGHT", "property": "height" }
    ],
    "animationScripts":
    [
        {
            "name": "show",
		        "script" : [ { "anim" : "MOD_SLIDE_IN_RIGHT" } ]
        },
        {
            "name": "hide",
		        "script" : [ { "anim" : "SCREEN_TRANSITION_OUT" } ]
        }
    ],
  "children": [
    {
      "commonName": "Panel",
      "name": "UIFrame",
      "alignV": "CENTER",
      "alignH": "FILL",
      "height": 580,
      "children": [

        {
          "commonName": "Panel",
          "name": "MenuLayout",
          "alignV": "TOP",
          "alignH": "FILL",
          "marginTop": 7,
          "height": 30,
          "children": [

            {
              "commonName": "Label",
              "alignV": "CENTER",
              "alignH": "LEFT",
              "marginBottom": 1,
              "marginLeft": 235,
			  "fontSize": 22,
			  "fontColor": "0xffffff",
			  "text": ""
            }
          ]
        }
      ]
    },
    {
      "commonName": "Panel",
      "name": "UIFrame",
      "alignV": "CENTER",
      "alignH": "CENTER",
      "marginTop": 40,
      "width": 1100,
      "height": 400,
      "alpha": 1,
      "children": [
        {
          "commonName": "Panel",
          "alignV": "FILL",
          "alignH": "LEFT",
          "width": 350,
          "children": [
            {
              "commonName": "Rectangle",
              "alignV": "FILL",
              "alignH": "FILL",
              "cornerRaduis": 15,
              "alpha": 1,
			  "bindings": [
                {
				   "binding": "bnd_color_tourid",
                   "property": "color"
				}
              ]
            },
			{
              "commonName": "Label",
              "alignV": "TOP",
              "alignH": "CENTER",
              "marginTop": 7,
              "fontSize": 20,
			  "fontColor": "0xFFFFFF",
              "fontFace": "$MONTBLANC_TRIAL_EXTRABOLD",
              "forceCaps": true,
			  "text": "GROUP STAGE"
			},
            {
              "commonName": "Label",
              "alignV": "TOP",
              "alignH": "CENTER",
              "marginTop": 50,
              "fontSize": 13,
              "fontColor": "0xFFFFFF",
              "fontFace": "$MONTBLANC_TRIAL_EXTRABOLD",
              "forceCaps": true,
              "bindings": [
                { "binding": "bnd_group_label_current", "property": "text" }
              ]
            },
            {
              "commonName": "Label",
              "alignV": "TOP",
              "alignH": "CENTER",
              "marginTop": 65,
              "fontSize": 10,
              "fontFace": "$FONT_ORIGIN_KNULEXTRABOLD",
              "fontColor": "$COLOR_YELLOW",
              "bold": false,
              "bindings": [
                { "binding": "bnd_month_label", "property": "text" }
              ]
            },
            {
              "commonName": "Panel",
              "name": "TableMatch",
              "alignV": "FILL",
              "alignH": "FILL",
              "width": 495,
              "scaleX": 0.6,
              "scaleY": 0.6,
              "alpha": 1,
              "children": [
                {
                  "commonName": "VerticalList",
                  "name": "matchlist",
                  "alignV": "TOP",
                  "alignH": "LEFT",
                  "marginTop": 130,
                  "marginLeft": 60,
                  "displayRange": 8,
                  "highlightable": true,
                  "row": "FixturesSmallCustom",
                  "rowHeight": 63,
                  "rowWidth": 470,
                  "bindings": [
                    {
                      "binding": "bnd_fixtures_list",
                      "property": "dataProviders"
                    }
                  ]
                }
              ]
            },
            {
              "commonName": "AssetButton",
              "alignV": "TOP",
              "alignH": "CENTER",
              "marginTop": 40,
              "marginLeft": -100,
              "clickAction": "act_prev_group",
              "buttonAsset": "$BlueArrowLeft"
            },
            {
              "commonName": "AssetButton",
              "alignV": "TOP",
              "alignH": "CENTER",
              "marginTop": 40,
              "marginLeft": 100,
              "clickAction": "act_next_group",
              "buttonAsset": "$BlueArrowRight"
            }
          ]
        },
        {
          "commonName": "Panel",
          "alignV": "FILL",
          "alignH": "RIGHT",
          "width": 745,
          "children": [
            {
              "commonName": "Rectangle",
              "alignV": "FILL",
              "alignH": "FILL",
              "cornerRaduis": 15,
              "alpha": 1,
			  "bindings": [
                {
				   "binding": "bnd_color_tourid",
                   "property": "color"
				}
              ]
            },
			{
              "commonName": "Rectangle",
              "alignV": "BOTTOM",
              "alignH": "CENTER",
              "marginBottom": 60,
              "width": 705,
              "height": 2,
              "color": "0x757575",
              "alpha": 0.4
            },
            {
              "commonName": "Rectangle",
              "alignV": "CENTER",
              "alignH": "CENTER",
              "marginTop": -20,
              "width": 735,
              "height": 250,
              "cornerRaduis": 15,
              "color": "0xffffff",
              "alpha": 0
            },
            {
              "commonName": "Label",
              "alignV": "TOP",
              "alignH": "CENTER",
              "marginTop": 60,
              "fontSize": 23,
              "fontColor": "0xffffff",
              "fontFace": "$FONT_ORIGIN_KNULEXTRABOLD",
              "bindings": [
                { "binding": "bnd_group_label_current", "property": "text" }
              ]
            },
            {
              "commonName": "Panel",
              "name": "TableMatch",
              "alignV": "FILL",
              "alignH": "FILL",
              "width": 495,
              "scaleX": 0.6,
              "scaleY": 0.6,
              "alpha": 1,
              "children": [
                {
                  "commonName": "VerticalList",
                  "name": "matchlist",
                  "alignV": "TOP",
                  "alignH": "LEFT",
                  "marginTop": 150,
                  "marginLeft": 20,
                  "displayRange": 5,
                  "highlightable": true,
                  "row": "StandingsRowCustom",
                  "rowHeight": 65,
                  "rowWidth": 1750.0,
                  "bindings": [
                    {
                      "binding": "bnd_group_standings",
                      "property": "dataProviders"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "commonName": "Panel",
          "alignV": "FILL",
          "alignH": "RIGHT",
          "width": 745,
          "children": [
            {
              "commonName": "SimpleButton",
              "alignH": "FILL",
              "alignV": "BOTTOM",
              "marginBottom": 0,
              "marginLeft": 0,
              "scaleX": 1.0,
              "scaleY": 2.5,
              "alpha": 1,
			  "backgroundImage": "",
			  "backgroundHighlightImage": "",
              "clickAction": "act_next_group"
            },
            {
              "commonName": "SimpleButton",
              "alignH": "FILL",
              "alignV": "BOTTOM",
              "marginBottom": 340,
              "marginLeft": 0,
              "scaleX": 1.0,
              "scaleY": 2.5,
              "alpha": 1,
			  "backgroundImage": "",
			  "backgroundHighlightImage": "",
              "clickAction": "act_prev_group"
            },
            {
              "commonName": "Label",
              "alignV": "TOP",
              "alignH": "CENTER",
              "marginTop": 10,
              "fontSize": 15,
              "fontColor": "0xFFFFFF",
              "alpha": 0.6,
              "fontFace": "$FONT_ORIGIN_KNULEXTRABOLD",
              "bindings": [
                { "binding": "bnd_group_label_prev", "property": "text" }
              ]
            },
            {
              "commonName": "Label",
              "alignV": "BOTTOM",
              "alignH": "CENTER",
              "marginBottom": 30,
              "fontSize": 20,
              "fontColor": "0xFFFFFF",
              "alpha": 0.6,
              "fontFace": "$FONT_ORIGIN_KNULEXTRABOLD",
              "bindings": [
                { "binding": "bnd_group_label_next", "property": "text" }
              ]
            }
          ]
        }
      ]
    }
  ]
}