                                            "alpha": 0,
                                            "marginLeft": 70
                                        },
                                        "duration": 1
                                    }
                                },
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 1,
                                            "marginLeft": 70
                                        },
                                        "duration": 1000,
                                        "easing": "OutBack"
                                    }
                                }
                            ]
                        }
                    ],
                    "children":
                    [                                            
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
