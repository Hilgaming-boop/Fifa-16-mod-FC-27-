                            "marginTop": -2,
                            "marginLeft": 80,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$MONTBLANC_TRIAL_BOLD",
                            "text": "Home"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 165,
                            "fontSize": 25,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.3,
                            "text": "|"
                        }
                    ]
                }
            ],
            "behaviors":
            [
                {
                    "commonName": "TriggerScriptBehavior",
                    "name": "trigger_animate_bt",
                    "script": "animateBt",
                    "target": "BtPanel"
                },
                {
                    "commonName": "TriggerOnTrue",
                    "name": "trigger_on_true_bt",
                    "target": "trigger_animate_bt",
                    "bindings":
                    [
                        {
                            "binding": "bnd_animate_count1",
                            "property": "value"
                        }
                      ]
                   }
                ]
             },         
               {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 0,
                    "marginLeft": 70,                    
                    "height": 30,
                    "children":
                    [
                {
                    "commonName": "Panel",
                    "name": "BtPanel",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginTop": 0,
                    "marginLeft": 0,
                    "width": 300,
                    "height": 15,
                    "alpha": 0,
                    "animationScripts":
                    [
                        {
                            "name": "animateBt",
                            "script":
                            [
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 0,
                                            "marginLeft": 70
                                        },
                                        "duration": 1
                                    }
                                },
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 1,
                                            "marginLeft": -70
                                        },
                                        "duration": 1000,
                                        "easing": "OutBack"
                                    }
                                }
                            ]
                        }
                    ],
                    "children":
                    [                    
        {
          "commonName": "TabBar",
          "alignV": "TOP",
          "alignH": "LEFT",
          "marginTop": 0,
          "marginLeft": 250,
          "width": 400,
          "height": 30,
          "tabs": [
            {
              "label": "Central",
              "clickAction": "act_tab1"
            },
            {
              "label": "Squad",
              "clickAction": "act_tab2"
            },
            {
              "label": "Office",
              "clickAction": "act_tab3"
            },
            {
              "label": "Customise",
              "clickAction": "act_tab4"
            }
          ],
          "bindings": [
            {
              "binding": "bnd_tab_index",
              "property": "selectedIndex"
                        }
                    ]
                }
                ]
                }
            ],
            "behaviors":
            [
                {
                    "commonName": "TriggerScriptBehavior",
                    "name": "trigger_animate_bt",
                    "script": "animateBt",
                    "target": "BtPanel"
                },
                {
                    "commonName": "TriggerOnTrue",
                    "name": "trigger_on_true_bt",
                    "target": "trigger_animate_bt",
                    "bindings":
                    [
                        {
                            "binding": "bnd_animate_count2",
                            "property": "value"
                        }
                      ]
                   }
                ]
             }        ,
                {
                            "commonName": "Image",
                            "name": "HomeCrest",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": -3,
                            "marginLeft": 1085,
                            "width": 35,
                            "height": 35,
                            "bindings":
                            [
                               {
                                   "binding": "bnd_team_crest",
                                   "property": "image"
                               }
                            ]
                        },
                        {
                            "commonName": "Asset",
                            "alignV": "TOP",
                            "alignH": "CENTER",
                            "marginLeft": 460,
                            "marginTop": -15,
                            "width": 240,
                            "height": 70,
                            "type": "$Icon_Tim_Central"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": 7,
                            "marginLeft": 1123,
                            "fontSize": 18,
                            "fontFace": "$CruyffSansRegular",
                            "fontColor": "0xffffff",
                            "textAlignH": "LEFT",
                            "width": 110,
                            "autoScroll":true,
                            "alpha": 0.5,
                            "bindings":
                            [
                               {
                                  "binding": "bnd_team_name",
                                  "property": "text"
                               }
                            ]
                        }
            ]
        }
    ]
}