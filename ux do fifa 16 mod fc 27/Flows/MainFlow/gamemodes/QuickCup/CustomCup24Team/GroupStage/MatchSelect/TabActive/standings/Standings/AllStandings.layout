{
  "commonName": "Panel",
  "name": "rootContainer",
  "alignV": "CENTER",
  "alignH": "CENTER",
  "bindings": [
    { "binding": "BND_SCREEN_WIDTH", "property": "width" },
    { "binding": "BND_SCREEN_HEIGHT", "property": "height" }
    ],
    "animationScripts":
    [
        {
            "name": "show",
		        "script" : [ { "anim" : "MOD_SLIDE_IN_RIGHT" } ]
        },
        {
            "name": "hide",
		        "script" : [ { "anim" : "SCREEN_TRANSITION_OUT" } ]
        }
    ],
