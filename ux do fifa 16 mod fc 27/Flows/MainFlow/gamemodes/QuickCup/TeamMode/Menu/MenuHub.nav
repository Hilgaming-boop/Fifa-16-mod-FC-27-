{
    "name": "MenuHub",
    "onEnter":
    [
        ["invoke", ["evt_show_stage_background"]],
        ["blockingLoadVVM", ["MenuHub.vvm"]]
    ],
    "onExit":
    [
        ["unloadVVM"]
    ],
    "transitions":
    [
                {
                    "event": "evt_CustomCup",
                    "targets": ["CustomCup"]
                },    
        {
            "event": "evt_back",
            "targets": ["out_exit_gamemode"]
        }
    ]
}