{
    "name": "KitSelect",
    "initial":
    {
        "targets": ["KitSelectStartMatch"]
       },
            "onEnter":
            [
                ["updateUserPlateDisplayMode", ["lite"]],
                ["setNavigationBarNavContext", [".gamemode", ".flow", ".type", "kitselect"]]
            ],
            "onExit":
            [
	         	["updateUserPlateDisplayMode", ["full"]],
                 ["resetNavigationBarNavContext"]
            ],
            "states":
            [
         {
            "name": "KitSelectStartMatch",
            "onEnter":
            [
                ["loadVVM", ["KitSelectStartMatch.vvm",
                    {
                        "gamemode": ".gamemode",
                        "flow":     ".flow",
                        "type":     ".type",
                        "skipFE":   ".SKIP_FE",
						"fromScreen": ".fromScreen"
                    }
                ]],
                ["notifyEnterKitSelect"]
            ],
            "onExit":
            [
                ["notifyExitKitSelect"],
                ["unloadVVM"]
            ],
            "transitions":
            [
                {
                    "event":   "evt_advance",
                    "targets": ["PlayMatch"]
                },
                {
                    "event":   "evt_back",
                    "targets": ["out_exit_gamemode"]
                }
            ]
        },
        {
            "name": "PlayMatch",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/QuickCup/TeamMode/PlayMatch/Match.nav",
            "outputs":
            {
                "out_exit_gamemode": "out_exit_gamemode1"
            }
        }
    ]
}
