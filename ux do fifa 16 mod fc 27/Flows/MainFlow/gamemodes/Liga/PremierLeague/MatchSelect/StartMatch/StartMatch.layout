/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings": [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts": [
        {
            "name": "show",
            "script": [{ "anim": "SCREEN_SHOW" }]
        },
        {
            "name": "hide",
            "script": [{ "anim": "SIMPLE_SCREEN_HIDE" }]
        }
    ],
    "children": [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Liga"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 1,
            "type": "$eplBg"
        },     
		{
            "commonName": "Label",
            "alignV": "TOP",
            "alignH": "CENTER",
            "marginTop": 30,
            "marginLeft": 0,
            "fontSize": 23,
            "fontColor": "$COLOR_WHITE",
            "fontFace": "$CruyffSans-Regular",
            "bold":true,
            "text": "Premier\nLeague"
        },		
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "marginBottom": -15,
            "marginLeft": 10,
            "children": [
                {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_exit"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                }
            ]
        },     
        {
                    "commonName": "Panel",
                    "name": "MatchDataPanel",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginLeft": 260,
                    "marginTop": -40,
                    "width": 800,
                    "height": 600,
                    "scaleX": 1.0,
                    "scaleY": 1.0,
                    "visible": true,
                    "children": [
