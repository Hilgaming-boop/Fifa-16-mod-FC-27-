{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "children":
    [
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "children":
            [
                {
                    "commonName": "Panel",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginLeft": -7,
                    "marginTop": 15,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "CENTER",
                            "marginLeft": 0,
                            "marginTop": -35,
                            "width": 500,
                            "height": 370,
                            "type": "$Tab_Cup_Select",
                            "alpha": 0.5
                        }                     
                            ]
                        }
                    ]
                }
            ]
         }
     ]
}
