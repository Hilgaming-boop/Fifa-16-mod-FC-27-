/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "children":
    [
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "children":
            [
                {
                    "commonName": "Panel",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 705,
                    "marginTop": 14,
                    "width": 300,
                    "height": 440,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginLeft": 325,
                            "marginTop": -35,
                            "width": 300,
                            "height": 370,
                            "type": "$Tab_Cup_Select",
                            "alpha": 0.5
                        },
                        {
                            "commonName": "Panel",
                            "alignV": "BOTTOM",
                            "alignH": "CENTER",
                            "marginLeft": -15,
                            "marginBottom": 0,
                            "height": 50,
                            "width": 200,
                            "children":
                            [
                                {
                                    "commonName": "Image",
                                    "alignH": "CENTER",
                                    "alignV": "CENTER",
                                    "marginLeft": 340,
                                    "marginTop": 0,
                                    "height": 90,
                                    "width": 190,
                                    "bindings":
                                    [
                                      {
                                         "binding": "bnd_button_liga",
                                         "property": "image"
                                      }        
                                   ]
                                },                                                 
                                {
                                    "commonName": "SimpleButton",
                                    "alignH": "CENTER",
                                    "alignV": "CENTER",
                                    "marginLeft": 340,
                                    "marginTop": 0,
                                    "height": 90,
                                    "width": 190,
                                    "backgroundImage": "$",
                                    "backgroundHighlightImage": "$",
                                    "clickAction": "act_fixtures"
                                },
                                {
		                            "commonName": "Asset",
		                            "alignV": "CENTER",
		                            "alignH": "CENTER",
                                    "marginLeft": 275,
		                            "marginTop": 0,
		                            "width": 35,
                                    "height": 35,
		                            "type": "$SimMatchIcon1",
                                    "alpha": 1
		                        },                                
                                {
                                    "commonName": "Label",
                                    "alignV": "CENTER",
                                    "alignH": "CENTER",
                                    "marginLeft": 350,
                                    "marginBottom": -1,
                                    "fontSize": 17,
                                    "fontColor": "$COLOR_WHITE",
                                    "fontFace": "$FONT_ORIGIN_NORMAL",
                                    "text": "Tap To Fixtures"
                                }
                            ]
                        }
                    ]
                }
            ]
         }
     ]
}
/*-- Layout Design MVNPROD YouTube --*/