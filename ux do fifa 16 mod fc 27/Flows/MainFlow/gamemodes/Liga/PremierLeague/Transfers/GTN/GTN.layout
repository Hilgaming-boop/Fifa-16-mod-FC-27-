                    "height": 390,
                  "bindings": 
                  [
                     {
                         "binding": "bnd_tab_cup",
                         "property": "image"
                     }
                  ]        
                },                                       
                {
                "commonName": "Asset",
                    "alignV": "FILL",
                    "alignH": "FILL",
                    "cornerRaduis": 15,
                    "type": "$Scout_Info",
                    "alpha": 0
                    },
                        {
                    "commonName": "Label",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "fontSize": 25,
                    "fontColor": "$COLOR_WHITE",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
