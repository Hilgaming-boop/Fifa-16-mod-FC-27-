/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "behaviors":
    [
        {
            "commonName": "SquadCustomizationBehavior",
            "actionName": "act_mvnprod",
            "buttonContainer": "MvnprodButton"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
        "style-definitions":
    {
		"TF_LIVE_TILE_HEADLINE_BOLD_SMALL":
        {
			"fontFace": "$CruyffSansRegular",
			"fontSize": 15,
			"fontColor": "$COLOR_LIGHT_GRAY",
			"leading": -4
	    },
		"TF_LIVE_TILE_HEADLINE_SMALL": 
        {
			"fontFace": "$FONT_BODY",
			"fontSize": "$FONT_SIZE_SMALLEST_HEADER",
			"fontColor": "$COLOR_WHITE",
			"leading": -4
		},
		"TF_LIVE_TILE_HEADLINE_BOLD_HIGHLIGHTED_SMALL": 
        {
			"fontFace": "$CruyffSansRegular",
			"fontSize": 15,
			"fontColor": "$COLOR_WHITE",
			"leading": -4
		},
		"TF_LIVE_TILE_HEADLINE_HIGHLIGHTED_SMALL":
        {
			"fontFace": "$CruyffSansBold",
			"fontSize": 15,
		    "fontColor": "$COLOR_WHITE",
			"leading": -4
        }
    },
