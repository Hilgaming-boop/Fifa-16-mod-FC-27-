{
    "name": "Hub",
    "initial":
    {
        "targets": ["TeamHub"]
    },
    "states":
    [
		{
            "name": "TeamHub",
            "onEnter":
            [
                ["blockingLoadVVM", ["TeamRoster.vvm"]]
            ],
            "onExit":
