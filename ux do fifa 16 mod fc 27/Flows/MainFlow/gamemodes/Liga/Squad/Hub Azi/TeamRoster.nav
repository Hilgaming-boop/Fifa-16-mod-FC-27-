                {
                    "event": "evt_sell",
                    "targets": ["Sell"]
                }
            ]
        },
        {
            "name": "Sell",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/Liga/Squad/Hub/Sell/Sell.nav",
