{
    "commonName": "Panel",
    "name": "rootContainer",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        },
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        }
    ],
    "animationScripts":
    [
        {
		         	"name" : "show",
		         	"script" :
		         	[
			             	{
					              "anim" : "SLIDE_IN_ALPHA"
			             	}
		         	]
		     },
		     {
		         	"name" : "hide",
		         	"script" :
		         	[
			             	{
					              "anim" : "SLIDE_OUT"
			             	}
		         	]
	       	}
    ],
        "style-definitions":
