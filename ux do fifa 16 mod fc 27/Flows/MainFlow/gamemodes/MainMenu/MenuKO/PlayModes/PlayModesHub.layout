{
    "commonName": "Panel",
    "name": "rootContainer",
	"alignV": "CENTER",
    "alignH": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        },
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        }  
    ],
    "animationScripts":
    [
        {
            "name": "show",
            "script":
            [
                {
                    "anim": "TUTORIAL_TRANSITION_IN"
                }
            ]
        },
        {
            "name": "hide",
            "script":
            [
                {
                    "anim": "TUTORIAL_TRANSITION_OUT"
                }
            ]
        }
    ],
    "style-definitions":
    {
		"TF_TABS_IDLE":
		{
			"alignV": "CENTER",
			"fontFace": "$FONT_ORIGIN_NORMAL",
			"fontSize": "20",
			"fontColor": "$COLOR_WHITE",
			"alpha": 0.5,
			"width": 400
		},
		"TF_TABS_HIGHLIGHT":
		{
			"alignV": "CENTER",
			"fontFace": "$FONT_ORIGIN_NORMAL",
			"fontSize": "20",
			"fontColor": "$COLOR_WHITE",
			"width": 400
		},
		"TF_TABS_SELECTED":
		{
			"alignV": "CENTER",
			"fontFace": "$FONT_ORIGIN_NORMAL",
			"fontSize": "20",
			"fontColor": "$COLOR_WHITE",
			"alpha": 1,
			"width": 400
		}
    },    
    "behaviors":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Career"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.4,
            "type": "$Bg_Smoke"
        },    
        {
            "commonName": "TickerNavPublisher",
            "alignH": "LEFT",
            "icon": "$SimMatchIcon3",
            "actionName": "act_back",
            "label": "Back"
        }
    ],
    "children":
    [
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "CENTER",
                    "alignH": "FILL",
                    "marginTop": 0,
                    "marginLeft": -150,                    
                    "height": 30,
                    "children":
                    [
                {
                    "commonName": "Panel",
                    "name": "BtPanel",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginTop": 0,
                    "marginLeft": 0,
                    "width": 300,
                    "height": 15,
                    "alpha": 0,
                    "animationScripts":
                    [
                        {
                            "name": "animateBt",
                            "script":
                            [
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 0,
                                            "marginLeft": 70
                                        },
                                        "duration": 1
                                    }
                                },
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 1,
                                            "marginLeft": 70
                                        },
                                        "duration": 1000,
                                        "easing": "OutBack"
                                    }
                                }
                            ]
                        }
                    ],
                    "children":
                    [                                 
        {
            "commonName": "Asset",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": 0,
            "marginLeft": -522,
            "width": 105,
            "height": 640,
            "type": "$_KOinfo"
                        }
                    ]
                }
            ],
            "behaviors":
            [
                {
                    "commonName": "TriggerScriptBehavior",
                    "name": "trigger_animate_bt",
                    "script": "animateBt",
                    "target": "BtPanel"
                },
                {
                    "commonName": "TriggerOnTrue",
                    "name": "trigger_on_true_bt",
                    "target": "trigger_animate_bt",
                    "bindings":
                    [
                        {
                            "binding": "bnd_animate_count0",
                            "property": "value"
                        }
                      ]
                   }
                ]
             },         
