{
    "commonName": "Panel",
    "name": "rootContainer",
	"alignV": "CENTER",
    "alignH": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        },
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        }
    ],
    "children":
    [    
         {
            "commonName": "Panel",
            "name": "MenuLayout",
            "alignV": "CENTER",
            "alignH": "FILL",
            "marginLeft": -100,
            "marginTop": 0,
            "height": 450,
            "children":
            [    
                {
                    "commonName": "Panel",
                    "name": "BtPanel",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginTop": 0,
                    "marginLeft": 0,
                    "width": 300,
                    "height": 15,
                    "alpha": 0,
                    "animationScripts":
                    [
                        {
                            "name": "animateBt",
                            "script":
                            [
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 0,
                                            "marginLeft": 0
                                        },
                                        "duration": 1
                                    }
                                },
                                {
                                    "type": "Direct",
                                    "data": {
                                        "end": {
                                            "alpha": 1,
                                            "marginLeft": 50
                                        },
                                        "duration": 500,
                                        "easing": "OutBack"
                                    }
                                }
                            ]
                        }
                    ],
                    "children":
                    [    
        {
            "commonName": "Label",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": -70,
            "marginLeft": 20,
            "fontSize": 70,
            "fontFace": "$EAFC-Gamemodes",
	        "fontColor": "0xffffff",
            "text": "RM"
        },
        {
            "commonName": "Label",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": 0,
            "marginLeft": 0,
            "fontSize": 27,
            "fontFace": "$FONT_CRUYFFSANSBOLD",
	        "fontColor": "0xffffff",
	        "text": "Experience the greatest classics in"			  
         },
         {
            "commonName": "Label",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": 30,
            "marginLeft": 0,
            "fontSize": 27,
            "fontFace": "$FONT_CRUYFFSANSBOLD",
	        "fontColor": "0xffffff",
	        "text": "world football."			  
         },
         {
            "commonName": "Label",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": 70,
            "marginLeft": 0,
            "fontSize": 16,
            "fontFace": "$FONT_CRUYFFSANSMEDIUM",
	        "fontColor": "0xffffff",
	        "text": "Barcelona x Real Madrid • Inter x Milan ..."			  
         }
                    ]
                }
            ],
            "behaviors":
            [
                {
                    "commonName": "TriggerScriptBehavior",
                    "name": "trigger_animate_bt",
                    "script": "animateBt",
                    "target": "BtPanel"
                },
                {
                    "commonName": "TriggerOnTrue",
                    "name": "trigger_on_true_bt",
                    "target": "trigger_animate_bt",
                    "bindings":
                    [
                        {
                            "binding": "bnd_animate_count1",
                            "property": "value"
                        }
                    ]
                }
             ]
		 },                        
         {
            "commonName": "SimpleButton",
