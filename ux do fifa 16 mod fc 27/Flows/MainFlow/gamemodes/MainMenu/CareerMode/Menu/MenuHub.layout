/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "QUICK_ANIMATION_IN" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SLIDE_OUT" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Kick"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.3,
            "type": "$Bg_Smoke"
        },        
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
                {
                "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 120,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon1",
                    "clickAction": "act_tab_mission27"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 176,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Unselect"
                },
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 40,
                    "marginLeft": 30,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 60,
                            "width": 0.5,
                            "height": 0.5,
                            "type": "$Icon_Cm"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -20,
                            "marginLeft": 40,
                            "fontSize": 20,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$CruyffSans-Regular",
                            "alpha": 0.8,
                            "text": "Select Gender"
                        },
                        {
                        "commonName": "Rectangle",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 25,
                            "width": 400,
                            "height": 1,
                            "color": "0xFFFFFF",
                            "alpha": 0.2
                            },
                        {
                        "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 20,
                            "marginLeft": 40,
                            "fontSize": 20,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$CruyffSans-Regular",
                            "alpha": 0.8,
                            "text": "Select Region"
                        },
                        {
                        "commonName": "Rectangle",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 40,
                            "marginLeft": 25,
                            "width": 400,
                            "height": 1,
                            "color": "0xFFFFFF",
                            "alpha": 0.2
                            },
                        {
                        "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 60,
                            "marginLeft": 40,
                            "fontSize": 20,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$CruyffSans-Regular",
                            "alpha": 0.8,
                            "text": "Select League"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 230,
                            "fontSize": 25,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0,
                            "text": "|"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -20,
                            "marginLeft": 260,
                            "fontSize": 19,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$EPL",
                            "alpha": 1,
                            "text": "Men's Teams"
                            },
                        {
                        "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 20,
                            "marginLeft": 230,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$CruyffSans-Extended",
                            "alpha": 0,
                            "text": "Europe & America"
                            },
                        {
                        "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 60,
                            "marginLeft": 230,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$CruyffSans-Extended",
                            "alpha": 0,
                            "text": "All Leagues"
                        }
                    ]
                }
            ]
        },
        {
            "commonName": "Panel",
            "name": "ButtonClick",
            "alignV": "CENTER",
            "alignH": "CENTER",
            "marginTop": 0,
            "marginLeft": 0,
            "children":
            [
                {
                    "commonName": "GridTable",
                    "name": "Slide",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginLeft": -470,
                    "marginTop": 50,
                    "x": 0.0,
                    "y": 0.0,
                    "height": 350,
                    "width": 390,
                    "rows": 3,
                    "columns": 3,
                    "hasArrows": false,
                    "consumeInput": false,
                    "animated": true,
                    "useTimer": false,
                    "timeRemaining": 0,
                    "itemType": "LiveTile",
                    "autoScaleImageToTileHeight": false,
                    "bindings":
                    [
                        {
                            "binding": "bnd_live_menu",
                            "property": "dataProviders"
                        }
                    ]
                }
            ]
        }
    ]
}

/*-- Layout Design MVNPROD YouTube --*/