/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "children":
    [
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "children":
            [
                {
                    "commonName": "Panel",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 80,
                    "marginTop": 15,
                    "width": 300,
                    "height": 440,
                    "children":
                    [
                        {
                        "commonName": "Asset",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginLeft": -35, 
                            "marginTop": 76,
                            "width": 125,
                            "height": 104,
                            "type": "$Tab_Select_Mision1",
                            "alpha": 1
                        },
                        {
                    "commonName": "Asset",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginTop": 20,
                    "marginLeft": 700,
                    "height": 600,
                    "width": 600,
                    "type": "$Icon_1"
                    },
                                {
                                    "commonName": "Label",
                                    "alignV": "CENTER",
                                    "alignH": "CENTER",
                                    "marginLeft": 130,
                                    "marginBottom": 230,
                                    "fontSize": 19,
                                    "fontColor": "0xFFFFFF",
                                    "fontFace": "$CruyffSans-Extended-Heavy",
                                    "text": "England"
                },
                        {
                        "commonName": "Label",
                                    "alignV": "CENTER",
                                    "alignH": "CENTER",
                                    "marginLeft": 130,
                                    "marginBottom": 190,
                                    "fontSize": 19,
                                    "fontColor": "0xFFFFFF",
                                    "fontFace": "$CruyffSans-Extended-Heavy",
                                    "text": "Premier League"
                },
                        {
                            "commonName": "Panel",
                            "alignV": "BOTTOM",
                            "alignH": "CENTER",
                            "marginBottom": 0,
                            "height": 50,
                            "width": 200,
                            "children":
                            [
                                {
                                    "commonName": "SimpleButton",
                                    "alignH": "CENTER",
                                    "alignV": "CENTER",
                                    "marginLeft": 510,
                                    "marginTop": 20,
                                    "height": 70,
                                    "width": 140,
                                    "backgroundImage": "$Tab_Action_Green",
                                    "backgroundHighlightImage": "$Tab_Action_Green",
                                    "clickAction": "act_missionmode1"
                                },
                                {
                                    "commonName": "Label",
                                    "alignV": "CENTER",
                                    "alignH": "CENTER",
                                    "marginLeft": 509,
                                    "marginBottom": -21,
                                    "fontSize": 19,
                                    "fontColor": "$COLOR_WHITE",
                                    "fontFace": "$CruyffSans-Bold",
                                    "text": "Select"
                                }
                            ]
                        }
                    ]
                }
            ]
         }
     ]
}
