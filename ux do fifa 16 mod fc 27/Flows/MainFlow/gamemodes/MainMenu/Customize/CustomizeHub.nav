{
    "name": "CustomizeHub",
    "initial":
    {
        "targets": ["RedirectCustomizeHub"]
    },
    "states":
    [
		{
            "name": "RedirectCustomizeHub",
            "onEnter":
            [
                ["blockingLoadVVM", ["CustomizeHub.vvm"]]
            ],
            "onExit":
            [
                ["unloadVVM"]
            ],
            "transitions":
            [
                {
                    "event": "evt_back",
                    "targets": ["out_exit_gamemode"]
                 },
                 {
                    "event": "evt_team_roster",
                    "targets": ["TeamRoster"]
                 },
                 {
                    "event": "evt_credits",
                    "targets": ["Credits"]
                },
                 {
                    "event": "evt_termsofservice",
                    "targets": ["Profile"]
                }                
            ]
        },
        {
            "name": "TeamRoster",
            "type": "external",
            "file": "/Flows/MainFlow/TeamSheets/TeamSelectHub.nav",
            "outputs":
            {
                "out_exit_gamemode": "CustomizeHub"
            }
        },
        {
            "name": "Credits",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/MainMenu/Customize/Credits/CreditsHub.nav",
            "outputs":
            {
                "out_exit_gamemode": "CustomizeHub"
            }
        },
        {
            "name": "Profile",
            "type": "external",
            "file": "/Flows/MainFlow/GameModes/MainMenu/More/Menu/Profile/ProfileHub.nav",
            "outputs":
            {
                "out_exit_gamemode": "CustomizeHub"
            }
        }        
    ]
}