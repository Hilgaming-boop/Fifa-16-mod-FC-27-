/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name": "show",
            "script":
            [
                {
                    "anim": "MOD_SLIDE_IN_RIGHT"
                }
            ]
        },
        {
            "name": "hide",
            "script":
            [
                {
                    "anim": "MOD_SLIDE_OUT_RIGHT"
                }
            ]
        }
    ],
    "children":
    [
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 7,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": -30,
                            "marginLeft": 390,
                            "height": 90,
                            "width": 225,
                            "alpha": 1,
                            "path": "views/backgrounds/Green_Effect.swf"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 445.9,
                            "fontSize": 0,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "text": "Mens Clubs"
                        }
                    ]
                }
            ]
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "FILL",
            "alignH": "FILL",
            "children":
            [
                {
                    "commonName": "Panel",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "marginLeft": 80,
                    "marginTop": 5,
                    "width": 700,
                    "height": 380,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "TOP",
                            "alignH": "CENTER",
                            "width": 700,
                            "height": 320,
                            "type": "$Tab_Mens"
                        },
                        {
                            "commonName": "Panel",
                            "alignV": "BOTTOM",
                            "alignH": "CENTER",
                            "height": 50,
                            "width": 200,
                            "children":
                            [
                                {
                                    "commonName": "SimpleButton",
                                    "alignH": "CENTER",
                                    "alignV": "CENTER",
                                    "marginLeft": 0,
                                    "marginTop": 0,
                                    "height": 70,
                                    "width": 160,
                                    "backgroundImage": "$Tab_Action_Green",
                                    "backgroundHighlightImage": "$Tab_Action_Green",
                                    "clickAction": "act_rivalmens"
                                },
                                {
                                    "commonName": "Label",
                                    "alignV": "CENTER",
                                    "alignH": "CENTER",
                                    "marginLeft": 0,
                                    "marginBottom": -1,
                                    "fontSize": 15,
                                    "fontColor": "0xFFFFFF",
                                    "fontFace": "$timer",
                                    "text": "Tap To Play"
                                }
                            ]
                        }
                    ]
                }
            ]
         }
     ]
}
/*-- Layout Design MVNPROD YouTube --*/