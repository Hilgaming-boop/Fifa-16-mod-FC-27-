/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "style-definitions":
    {
		"TF_TABS_IDLE":
		{
			"alignV": "CENTER",
			"fontFace": "$FONT_ORIGIN_NORMAL",
			"fontSize": "22",
			"fontColor": "$COLOR_WHITE",
			"alpha": 0.5,
			"width": 400
		},
		"TF_TABS_HIGHLIGHT":
		{
			"alignV": "CENTER",
			"fontFace": "$FONT_ORIGIN_NORMAL",
			"fontSize": "22",
			"fontColor": "$COLOR_WHITE",
			"width": 400
		},
		"TF_TABS_SELECTED":
		{
			"alignV": "CENTER",
			"fontFace": "$FONT_ORIGIN_NORMAL",
			"fontSize": "22",
			"fontColor": "$COLOR_WHITE",
			"alpha": 1,
			"width": 400
		}
    },    
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Career"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.3,
            "type": "$Bg_Smoke"
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
                {
                    "commonName": "Image",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginLeft": 400,
                    "marginTop": 30,
                    "scaleX":0.60,
                    "scaleY":0.60,
                    "bindings": 
                    [
                        {
                            "binding": "bnd_player3d",
                            "property": "image"
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 7,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -2,
                            "marginLeft": 50,
                            "fontSize": 40,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$EAFC-Gamemodes",
                            "text": "RM"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -2,
                            "marginLeft": 150,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "text": "Club"
                        },
                        {
                            "commonName": "Label",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 215,
                            "fontSize": 25,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.3,
                            "text": "|"
                        }
                    ]
                },
                {
                    "commonName": "TabBar",
                    "name": "BagianTab",
                    "alignV": "TOP",
                    "alignH": "LEFT",
                    "marginLeft": 250,
                    "marginTop": 0,
                    "width": 470,
                    "tabs":
                    [
                       {
                           "label": "Legends Clubs",
                           "clickAction": "act_legends"
                       },
                       {
                           "label": "Mens Clubs",
                           "clickAction": "act_mensteams"
                       },
                       {
                           "label": "Womenns Clubs",
                           "clickAction": "act_womensteams"
                       }
                   ],
                   "bindings":
                   [
                      {
                          "binding": "bnd_tab_index",
                          "property": "selectedIndex"
                      }
                   ]
                }
                
            ]
        }
        
    ]
}                       
/*-- Layout Design MVNPROD YouTube --*/