/*-- Layout Design MVNPROD YouTube --*/
{
    "commonName": "Panel",
    "alignH": "CENTER",
    "alignV": "CENTER",
    "bindings":
    [
        {
            "binding": "BND_SCREEN_HEIGHT",
            "property": "height"
        },
        {
            "binding": "BND_SCREEN_WIDTH",
            "property": "width"
        }
    ],
    "animationScripts":
    [
        {
            "name" : "show",
		        "script" : [ { "anim" : "SCREEN_SHOW" } ]
		    },
		    {
		       	"name" : "hide",
		       	"script" : [ { "anim" : "SIMPLE_SCREEN_HIDE" } ]
	      }
    ],
    "children":
    [
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "type": "$Bg_Rival"
        },
        {
            "commonName": "Asset",
            "alignV": "FILL",
            "alignH": "FILL",
            "alpha": 0.2,
            "type": "$Bg_Smoke"
        },
        {
            "commonName": "Panel",
            "name": "UIFrame",
            "alignV": "CENTER",
            "alignH": "FILL",
            "height": 580,
            "children":
            [
               {
                    "commonName": "GenericButton",
                    "alignH": "LEFT",
                    "alignV": "BOTTOM",
                    "marginBottom": 0,
                    "marginLeft": 30,
                    "scaleX": 0.6,
                    "scaleY": 0.6,
                    "icon": "$SimMatchIcon2",
                    "clickAction": "act_back"
                },
                {
                    "commonName": "Label",
                    "alignV": "BOTTOM",
                    "alignH": "LEFT",
                    "marginBottom": 0,
                    "marginLeft": 86,
                    "fontSize": 14,
                    "fontColor": "$COLOR_LIGHT_GRAY",
                    "styles": ["TF_MATCH_REVEAL_TEAM_NAME"],
                    "text": "Back"
                },
                {
                    "commonName": "Image",
                    "alignV": "CENTER",
                    "alignH": "CENTER",
                    "marginLeft": 400,
                    "marginTop": 30,
                    "scaleX":0.60,
                    "scaleY":0.60,
                    "bindings": 
                    [
                        {
                            "binding": "bnd_player3d",
                            "property": "image"
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "MenuLayout",
                    "alignV": "TOP",
                    "alignH": "FILL",
                    "marginTop": 7,
                    "height": 30,
                    "children":
                    [
                        {
                            "commonName": "Asset",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 60,
                            "width": 65,
                            "height": 65,
                            "type": "$Icon_C"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": -2,
                            "marginLeft": 140,
                            "fontSize": 22,
                            "fontColor": "$COLOR_WHITE",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "text": "Clubs"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 215,
                            "fontSize": 25,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.3,
                            "text": "|"
                        },
                        {
                            "commonName": "Label",
                            "name": "Live",
                            "alignV": "CENTER",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": 257,
                            "fontSize": 22,
                            "fontColor": "$COLOR_LIGHT_GRAY",
                            "fontFace": "$FONT_ORIGIN_NORMAL",
                            "alpha": 0.5,
                            "text": "Select Match"
                        }
                    ]
                },
                {
                    "commonName": "Panel",
                    "name": "BagianMenu",
                    "alignV": "CENTER",
                    "alignH": "LEFT",
                    "width": 695,
                    "height": 410,
                    "marginTop": 10,
                    "marginLeft": 250,
                    "children":
                    [
                        {
                            "commonName": "Rectangle",
                            "alignV": "FILL",
                            "alignH": "FILL",
                            "color": "0x1C1C1C",
                            "cornerRaduis": 10,
                            "alpha": 1
                        },                    
                        {
                            "commonName": "Rectangle",
                            "alignV": "CENTER",
                            "alignH": "RIGHT",
                            "marginRight": 110,
                            "height": 395,
                            "width": 1,
                            "color": "0x555555",
                            "alpha": 0.5
                        },
                        {
                            "commonName": "VerticalList",
                            "name": "matchlist",
                            "alignV": "TOP",
                            "alignH": "LEFT",
                            "marginTop": 0,
                            "marginLeft": -30,
                            "x": 0,
                            "y": 0,
                            "displayRange": 4,
                            "rowChangeAction": "act_match_play",
                            "highlightable": true,
                            "row": "MatchRow",
                            "rowHeight": 102,
                            "rowWidth": 733,
                            "bindings":
                            [
                                {
                                    "binding": "bnd_match_list",
                                    "property": "dataProviders"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
/*-- Layout Design MVNPROD YouTube --*/